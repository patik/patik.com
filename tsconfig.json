{
    "extends": "astro/tsconfigs/strict",
    "include": [".astro/types.d.ts", "**/*"],
    "exclude": ["dist", "oldsite"],
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "strictNullChecks": true,
        "allowJs": true,
        "paths": {
            "@src/*": ["./src/*"]
        }
    }
}
