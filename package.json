{
    "name": "patik.com",
    "version": "3.0.0",
    "description": "Craig Patik’s personal web site",
    "homepage": "https://patik.com",
    "private": true,
    "engines": {
        "node": "24"
    },
    "scripts": {
        "dev": "astro dev",
        "astro": "astro",
        "build": "astro build",
        "start": "netlify dev",
        "start:prod": "pnpm run build && netlify serve",
        "lint": "pnpm eslint . && pnpm tsc --noEmit && pnpm lint:css && pnpm find-unused-sass-variables src/styles",
        "lint:css": "stylelint \"src/**/*.css\"",
        "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
        "prepare": "husky",
        "clear-fetch-cache": "rm -rf tmp",
        "clean": "rm -rf node_modules && pnpm run clear-fetch-cache",
        "test": "playwright test",
        "test:update-snapshots": "playwright test --update-snapshots",
        "test:ui": "playwright test --ui"
    },
    "lint-staged": {
        "src/**/*.css": "stylelint --fix"
    },
    "dependencies": {
        "@astrojs/mdx": "^5.0.4",
        "@astrojs/react": "^5.0.3",
        "astro": "^6.1.9",
        "astro-expressive-code": "^0.41.7",
        "classnames": "^2.5.1",
        "cloudinary": "^2.9.0",
        "date-fns": "^4.1.0",
        "lodash-es": "^4.18.1",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "react-google-charts": "^5.2.1"
    },
    "devDependencies": {
        "@astrojs/netlify": "^7.0.8",
        "@axe-core/playwright": "^4.11.2",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@playwright/test": "^1.59.1",
        "@tailwindcss/postcss": "^4.2.4",
        "@types/eslint-plugin-jsx-a11y": "^6.10.1",
        "@types/lodash": "^4.17.24",
        "@types/node": "^24.12.2",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/eslint-plugin": "^8.59.0",
        "@typescript-eslint/parser": "^8.59.0",
        "eslint": "^9.39.3",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-astro": "^1.7.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "find-unused-sass-variables": "^6.1.1",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "netlify-cli": "^25.6.0",
        "postcss": "^8.5.10",
        "prettier": "^3.8.3",
        "prettier-plugin-astro": "^0.14.1",
        "serve": "^14.2.6",
        "stylelint": "^17.9.0",
        "tailwindcss": "^4.2.4",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/patik/patik.com.git"
    },
    "author": {
        "name": "Craig Patik",
        "email": "craig@patik.com",
        "url": "https://patik.com"
    },
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/patik/patik.com/issues"
    },
    "packageManager": "pnpm@10.30.1"
}
