{
    "name": "patik.com",
    "version": "3.0.0",
    "description": "Craig Patik’s personal web site",
    "homepage": "https://patik.com",
    "private": true,
    "engines": {
        "node": "24"
    },
    "scripts": {
        "dev": "astro dev",
        "astro": "astro",
        "build": "astro build",
        "start": "netlify dev",
        "start:prod": "pnpm run build && netlify serve",
        "lint": "pnpm eslint . && pnpm tsc --noEmit && pnpm find-unused-sass-variables src/styles",
        "clear-fetch-cache": "rm -rf tmp",
        "clean": "rm -rf node_modules && pnpm run clear-fetch-cache",
        "test": "playwright test",
        "test:update-snapshots": "playwright test --update-snapshots",
        "test:ui": "playwright test --ui"
    },
    "dependencies": {
        "@astrojs/mdx": "^4.3.13",
        "@astrojs/react": "^4.4.2",
        "astro": "^5.17.3",
        "astro-expressive-code": "^0.41.6",
        "classnames": "^2.5.1",
        "cloudinary": "^2.9.0",
        "date-fns": "^4.1.0",
        "lodash-es": "^4.17.23",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-google-charts": "^5.2.1"
    },
    "devDependencies": {
        "@astrojs/netlify": "^6.6.4",
        "@axe-core/playwright": "^4.11.1",
        "@eslint/compat": "^2.0.2",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@playwright/test": "^1.58.2",
        "@tailwindcss/postcss": "^4.2.2",
        "@types/eslint-plugin-jsx-a11y": "^6.10.1",
        "@types/jest": "^30.0.0",
        "@types/lodash": "^4.17.24",
        "@types/node": "^24.7.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/eslint-plugin": "^8.56.0",
        "@typescript-eslint/parser": "^8.56.0",
        "eslint": "^9.39.3",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-astro": "^1.6.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "find-unused-sass-variables": "^6.1.1",
        "netlify-cli": "^23.15.1",
        "postcss": "^8.5.6",
        "prettier": "^3.8.1",
        "prettier-plugin-astro": "^0.14.1",
        "serve": "^14.2.5",
        "tailwindcss": "^4.2.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/patik/patik.com.git"
    },
    "author": {
        "name": "Craig Patik",
        "email": "craig@patik.com",
        "url": "https://patik.com"
    },
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/patik/patik.com/issues"
    },
    "packageManager": "pnpm@10.30.1"
}
