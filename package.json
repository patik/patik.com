{
    "name": "patik.com",
    "version": "3.0.0",
    "description": "Craig Patik’s personal web site",
    "homepage": "https://patik.com",
    "private": true,
    "engines": {
        "node": ">=26.3.0 <27"
    },
    "scripts": {
        "dev": "astro dev",
        "astro": "astro",
        "build": "astro build",
        "start": "netlify dev",
        "start:prod": "pnpm run build && netlify serve",
        "lint": "pnpm eslint . && pnpm tsc --noEmit && pnpm lint:css && pnpm find-unused-sass-variables src/styles",
        "lint:css": "stylelint \"src/**/*.css\"",
        "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
        "prepare": "husky",
        "clear-fetch-cache": "rm -rf tmp",
        "clean": "rm -rf node_modules && pnpm run clear-fetch-cache",
        "test": "playwright test",
        "test:update-snapshots": "playwright test --update-snapshots",
        "test:ui": "playwright test --ui"
    },
    "lint-staged": {
        "src/**/*.css": "stylelint --fix"
    },
    "dependencies": {
        "@astrojs/mdx": "^7.0.0",
        "@astrojs/react": "^6.0.0",
        "astro": "^7.0.0",
        "astro-expressive-code": "^0.43.1",
        "classnames": "^2.5.1",
        "cloudinary": "^2.10.0",
        "date-fns": "^4.3.0",
        "lodash-es": "^4.18.1",
        "react": "^19.2.7",
        "react-dom": "^19.2.6",
        "react-google-charts": "^5.2.1"
    },
    "devDependencies": {
        "@astrojs/netlify": "^8.0.0",
        "@axe-core/playwright": "^4.11.3",
        "@eslint/compat": "2.1.0",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@playwright/test": "^1.61.0",
        "@tailwindcss/postcss": "^4.3.0",
        "@types/eslint-plugin-jsx-a11y": "^6.10.1",
        "@types/lodash": "^4.17.24",
        "@types/node": "^26.0.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/eslint-plugin": "^8.62.0",
        "@typescript-eslint/parser": "^8.62.0",
        "eslint": "^10.5.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-astro": "^2.0.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "find-unused-sass-variables": "^6.2.1",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.8",
        "netlify-cli": "^26.0.1",
        "postcss": "^8.5.15",
        "prettier": "^3.8.4",
        "prettier-plugin-astro": "^0.14.1",
        "serve": "^14.2.6",
        "stylelint": "^17.12.0",
        "tailwindcss": "^4.3.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/patik/patik.com.git"
    },
    "author": {
        "name": "Craig Patik",
        "email": "craig@patik.com",
        "url": "https://patik.com"
    },
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/patik/patik.com/issues"
    },
    "packageManager": "pnpm@10.30.1"
}
