{
    "name": "patik.com",
    "version": "3.0.0",
    "description": "Craig Patik’s personal web site",
    "homepage": "https://patik.com",
    "private": true,
    "engines": {
        "node": "24"
    },
    "scripts": {
        "dev": "astro dev",
        "astro": "astro",
        "build": "astro build",
        "start": "netlify dev",
        "start:prod": "pnpm run build && netlify serve",
        "lint": "pnpm eslint . && pnpm tsc --noEmit && pnpm find-unused-sass-variables src/styles",
        "clear-fetch-cache": "rm -rf tmp",
        "clean": "rm -rf node_modules && pnpm run clear-fetch-cache",
        "test": "echo \"No tests yet\" && exit 0"
    },
    "dependencies": {
        "@astrojs/mdx": "^4.3.6",
        "@astrojs/react": "^4.4.0",
        "astro": "^5.14.1",
        "astro-expressive-code": "^0.41.3",
        "classnames": "^2.5.1",
        "cloudinary": "^2.7.0",
        "date-fns": "^4.1.0",
        "lodash-es": "^4.17.21",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-google-charts": "^5.2.1"
    },
    "devDependencies": {
        "@astrojs/netlify": "^6.5.11",
        "@astrojs/tailwind": "^6.0.2",
        "@eslint/compat": "^1.4.0",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
        "@types/eslint-plugin-jsx-a11y": "^6.10.1",
        "@types/jest": "^30.0.0",
        "@types/lodash": "^4.17.20",
        "@types/node": "^24.7.0",
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.1",
        "@typescript-eslint/eslint-plugin": "^8.46.0",
        "@typescript-eslint/parser": "^8.46.0",
        "eslint": "^9.37.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-astro": "^1.3.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^6.1.1",
        "find-unused-sass-variables": "^6.1.0",
        "netlify-cli": "^23.12.3",
        "prettier": "^3.6.2",
        "prettier-plugin-astro": "^0.14.1",
        "tailwindcss": "^3.4.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.0"
