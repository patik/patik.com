{
    "name": "patik.com",
    "version": "3.0.0",
    "description": "Craig Patik’s personal web site",
    "homepage": "https://patik.com",
    "private": true,
    "engines": {
        "node": ">=26.3.0 <27"
    },
    "scripts": {
        "dev": "astro dev",
        "astro": "astro",
        "build": "astro build",
        "check": "astro check",
        "start": "netlify dev",
        "start:prod": "pnpm run build && netlify serve",
        "lint": "pnpm oxlint . && pnpm check && pnpm lint:css",
        "lint:css": "stylelint \"src/**/*.css\"",
        "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
        "prepare": "husky",
        "clear-fetch-cache": "rm -rf tmp",
        "clean": "rm -rf node_modules && pnpm run clear-fetch-cache",
        "test": "playwright test --grep-invert @visual && scripts/visual.sh",
        "test:update-snapshots": "scripts/visual.sh --update-snapshots",
        "test:ui": "playwright test --ui",
        "test:visual": "scripts/visual.sh"
    },
    "lint-staged": {
        "src/**/*.css": "stylelint --fix"
    },
    "dependencies": {
        "@astrojs/markdown-remark": "7.2.2",
        "@astrojs/react": "^6.0.2",
        "astro": "^7.1.6",
        "classnames": "^2.5.1",
        "cloudinary": "^2.10.0",
        "d3-geo": "3.1.1",
        "date-fns": "^4.4.0",
        "lodash-es": "^4.18.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "rehype-expressive-code": "0.44.1",
        "topojson-client": "3.1.0",
        "world-atlas": "2.0.2"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "@axe-core/playwright": "^4.12.1",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@playwright/test": "^1.62.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/d3-geo": "3.1.1",
        "@types/lodash": "^4.17.25",
        "@types/node": "^26.1.2",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@types/topojson-client": "3.1.5",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "netlify-cli": "^27.1.0",
        "oxlint": "^1.77.0",
        "oxlint-tsgolint": "^7.0.2001",
        "postcss": "^8.5.25",
        "prettier": "^3.9.6",
        "prettier-plugin-astro": "^0.14.1",
        "serve": "^14.2.6",
        "stylelint": "^17.14.1",
        "tailwindcss": "^4.3.3",
        "typescript": "npm:@typescript/typescript6@^6.0.2"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/patik/patik.com.git"
    },
    "author": {
        "name": "Craig Patik",
        "email": "craig@patik.com",
        "url": "https://patik.com"
    },
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/patik/patik.com/issues"
    },
    "packageManager": "pnpm@11.20.0"
}
