---
import { Image } from 'astro:assets'
import Space from '../../components/Space'
import appNetPng from '../../images/app-net-twitter-char-count.png'
import magnetFullPng from '../../images/magnet-links.png'
import magnetPng from '../../images/magnet-links-preview.png'
import twitterAvatarPng from '../../images/twitter-avatar-in-menu.png'
import Layout from '../../layouts/Layout.astro'
import css from './UserScripts.module.css'

function getUserScriptUrl(fileName: string) {
    return `/code/user-scripts/${fileName}`
}
---

<Layout
    title="User Scripts - Readable Google Reader, Twitter Avatar, and more"
    keywords={[
        'user script',
        'google reader',
        'google+',
        'css',
        'javascript',
        'greasemonkey',
        'browser extension',
        'add-on',
    ]}
>
    <h1 class={css.pageTitle}>User Scripts</h1>

    <p>
        Install these in Chrome, Safari, or Firefox with
        <Space />
        <a href="https://addons.mozilla.org/en-US/firefox/addon/greasemonkey/">Greasemonkey</a>.
    </p>

    <section>
        <h2 class={css.sectionTitle}>Twitter avatar in menu</h2>
        <p>See which account you’re logged in under at a quick glance</p>
        <figure>
            <Image src={twitterAvatarPng} alt="" />
        </figure>
        <p>
            <a href={getUserScriptUrl('twitter-avatar-in-menu.user.js')} download class={css.button}
                >Install</a
            >
            <a href="https://gist.github.com/patik/2029861" class={css.button}> Gist </a>
        </p>
    </section>

    <section>
        <h2 class={css.sectionTitle}>Magnet Link Display</h2>
        <p>
            Displays <code>magnet://</code> links and other P2P URLs prominently. Great for sites that hide the real links
            between obnoxious “download” ad banners or open pop ups when you click on them.
        </p>
        <figure>
            <a href={magnetFullPng.src}>
                <Image src={magnetPng} alt="Magnet Link Display screenshot" />
            </a>
        </figure>
        <p>
            <a href={getUserScriptUrl('magent-links.user.js')} download class={css.button}>Install</a>

            <a href="https://gist.github.com/patik/8388768" class={css.button}> Gist </a>
        </p>
    </section>

    <section>
        <h2 class={css.sectionTitle}>Alpha.App.Net Enhanced</h2>
        <p>Enhance App.net by adding useful features to the Alpha web app.</p>
        <ul>
            <li>Repost &mdash; Easily repost/share another user’s post</li>
            <li>Image previews &mdash; See images from posts without having to open them</li>
            <li>
                Twitter character count &mdash; Ensure your post will fit within Twitter’s 140-character limit when you
                crosspost to both networks using <a href="https://twapp.phuu.net/">twapp</a>,<Space />
                <a href="https://ifttt.com/">ifttt</a>
                <Space />
                or other services.
            </li>
        </ul>
        <p>
            <a
                href="https://chrome.google.com/webstore/detail/agplbnminilmhgkkdngdodiallpempch"
                class={css.button}
            >
                Chrome Extension
            </a>
            <Space />
            <a href={getUserScriptUrl('alpha-app-net-enhanced.user.js')} download class={css.button}
                >Install</a
            >
            <Space />
            <a href="https://gist.github.com/3542903" class={css.button}> Gist </a>
        </p>
        <figure>
            <Image src={appNetPng} alt="" />
        </figure>
    </section>

    <section>
        <h2 class={css.sectionTitle}>Readable Reader</h2>
        <p>Compact styles for Google Reader</p>
        <p>
            <a href={getUserScriptUrl('readable-reader.user.js')} download class={css.button}>Install</a>
        </p>
    </section>

    <section>
        <h2 class={css.sectionTitle}>Readable Google+</h2>
        <p>Cleans up Google+ Post pages. Currently only eliminates the gigantic avatar in the sidebar.</p>
        <p>
            <a href={getUserScriptUrl('readable-google-plus.user.js')} download class={css.button}>Install</a
            >
        </p>
    </section>

    <section>
        <h2 class={css.sectionTitle}>Redirect from WikiTravel to WikiVoyage</h2>
        <p>
            When landing on a WikiTravel.org article, this script automatically redirects to the corresponding article
            on WikiVoyage.org.
        </p>
        <p>
            This <a href="https://en.wikipedia.org/wiki/Wikitravel#Community_fork_in_2012">brief description</a>
            <Space />
            of WikiVoyage’s creation reflects my reasons for preferring it. Despite updating my own bookmarks and shortcuts,
            this script is still necessary because links to WikiTravel often show up in search results, blogs, etc.
        </p>
        <p>
            <a href={getUserScriptUrl('wiki-travel-voyage-redirect.user.js')} download class={css.button}
                >Install</a
            >

            <a href="https://gist.github.com/patik/4979331" class={css.button}> Gist </a>
        </p>
    </section>

    <section>
        <h2 class={css.sectionTitle}>Readable Flickr</h2>
        <p>Legible (large-font) styles for Flickr</p>
        <p>
            <a href={getUserScriptUrl('readable-flickr.user.js')} download class={css.button}>Install</a>
        </p>
    </section>

    <section>
        <h2 class={css.sectionTitle}>Auto Login</h2>
        <p>
            Probably not useful for anyone else, this script will determine whether I’m logged in on certain sites. It
            then automatically navigates to the login page and, once my browser has auto-filled the fields, signs me in.
        </p>
        <p>
            <a href={getUserScriptUrl('auto-login.user.js')} download class={css.button}>Install</a>
        </p>
    </section>
</Layout>
