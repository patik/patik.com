---
import { Image } from 'astro:assets'
import travelCss from '@src/components/TravelLinkList.module.css'
import TravelLinkList from '../../components/TravelLinkList.astro'
import BrugesImage from '../../images/britain-benelux-bruges-link.jpg'
import OverviewMap from '../../images/britain-benelux-overview-map-small.jpg'
import Layout from '../../layouts/Layout.astro'
---

<Layout title="Belgium" keywords={['Belgium', 'Bruges', 'Europe', 'travel']}>
    <header class={travelCss.travelPageHeader}>
        <h1>Belgium</h1>
        <p>August 2012</p>
    </header>

    <section>
        <h2>Photos and Video</h2>

        <TravelLinkList
            items={[
                {
                    title: 'Bruges',
                    className: 'bg-belgium-bruges',
                    url: 'https://photos.app.goo.gl/A9bR6WGETT8DCFYe6',
                    imageSrc: BrugesImage,
                    imageAlt: 'Windmill in the Belgian countryside',
                },
            ]}
        />
    </section>

    <section>
        <h2>Itinerary</h2>
        <ul>
            <li>
                <a href="/travel/netherlands/">Netherlands</a>
            </li>
            <li>
                <strong>Bruges, Belgium</strong>
            </li>
            <li>Eurostar train to London, via Paris</li>
            <li>
                <a href="/travel/britain/">Edinburgh, Scotland</a>
            </li>
            <li>
                <a href="/travel/britain/">London</a>
            </li>
            <li>
                <a href="/travel/britain/">Liverpool</a>
            </li>
        </ul>
        <div class={travelCss.travelMap}>
            <a href="/images/britain-benelux-overview-map.png">
                <Image src={OverviewMap} alt="Map of trip locations" title="Click for a larger version" />
            </a>
        </div>
    </section>
</Layout>
