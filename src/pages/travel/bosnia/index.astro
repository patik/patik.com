---
import TravelLinkList from '../../../components/TravelLinkList.astro'
import travelCss from '@src/components/TravelLinkList.module.css'
import countryGallery from '../../../galleries/bosnia'
import MostarImage from '../../../images/bosnia-mostar-hero.jpg'
import SarajevoImage from '../../../images/bosnia-sarajevo-hero.jpg'
import Layout from '../../../layouts/Layout.astro'
---

<Layout title="Bosnia" keywords={countryGallery.keywords}>
    <header class={travelCss.travelPageHeader}>
        <h1>Bosnia and Herzegovina</h1>
        <p>May 2024</p>
    </header>

    <p>A 2024 trip through Bosnia and Herzegovina, from Sarajevo's layered history to Mostar's iconic Old Bridge.</p>

    <section>
        <h2>Photos</h2>

        <TravelLinkList
            items={[
                {
                    title: 'Sarajevo',
                    className: 'bg-travel-bottom-middle',
                    url: '/travel/bosnia/photos/sarajevo/',
                    imageSrc: SarajevoImage,
                    imageAlt: 'Sarajevo, Bosnia and Herzegovina',
                },
                {
                    title: 'Mostar',
                    className: 'bg-travel-top-middle',
                    url: '/travel/bosnia/photos/mostar/',
                    imageSrc: MostarImage,
                    imageAlt: 'Mostar, Bosnia and Herzegovina',
                },
            ]}
        />
    </section>

    <section>
        <h2>Itinerary</h2>
        <ul>
            <li>
                <a href="https://en.wikipedia.org/wiki/Sarajevo">Sarajevo</a>
            </li>
            <li>
                <a href="https://en.wikipedia.org/wiki/Mostar">Mostar</a>
            </li>
        </ul>
    </section>
</Layout>
