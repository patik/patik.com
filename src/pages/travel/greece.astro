---
import TravelLinkList from '../../components/TravelLinkList'
import athensLink from '../../images/greece-athens-link.jpg'
import santoriniLink from '../../images/greece-santorini-link.jpg'
import sifnosLink from '../../images/greece-sifnos-link.jpg'
import Layout from '../../layouts/Layout.astro'
---

<Layout title="Greece" keywords={['Greece, Athens, Santorini, Sifnos, Europe, Travel']}>
    <h1>Greece</h1>

    <p>
        This country keeps drawing us back year after year. After our initial visit, we took a brief hiatus, but have
        since enjoyed Greece on a year basis.
    </p>

    <hr />

    <section>
        <h2>2007</h2>
        <p>In July 2007 we spent our honeymoon in Greece.</p>

        <h3>Photos</h3>

        <p>
            <a href="https://photos.app.goo.gl/c83RXmpxQE3nz4266">Combined photo album</a>
        </p>

        <TravelLinkList
            items={[
                {
                    title: 'Athens',
                    className: 'bg-greece-athens',
                    url: 'https://photos.app.goo.gl/c83RXmpxQE3nz4266',
                    imageSrc: athensLink,
                    imageAlt: 'Temple of Zeus in Athens',
                },
                {
                    title: 'Sifnos',
                    className: 'bg-greece-sifnos',
                    url: 'https://photos.app.goo.gl/c83RXmpxQE3nz4266',
                    imageSrc: sifnosLink,
                    imageAlt: 'Coast of Serifios island',
                },
                {
                    title: 'Santorini',
                    className: 'bg-greece-santorini',
                    url: 'https://photos.app.goo.gl/c83RXmpxQE3nz4266',
                    imageSrc: santoriniLink,
                    imageAlt: 'Sunset over Oia, Santorini',
                },
            ]}
        />
    </section>
</Layout>
