---
import GalleryPage from '@src/components/gallery/GalleryPage.astro'
import assertGalleryModule from '@src/photos/utils/assertGalleryModule'
import getGalleryStaticPaths, { type GalleryPageProps } from '@src/photos/utils/getGalleryStaticPaths'
import type { CityGallery, CountryGallery } from '@src/photos/utils/types'

interface Props extends GalleryPageProps {
    countryGallery: CountryGallery
    cityGalleries: CityGallery[]
}

interface CountryGalleryPath {
    params: {
        country: string
        photos: string | undefined
    }
    props: Props
}

export async function getStaticPaths(): Promise<CountryGalleryPath[]> {
    const galleryModules = import.meta.glob('/src/galleries/*/index.ts', { eager: true })
    const galleryPaths = await Promise.all(
        Object.entries(galleryModules).map(async ([path, galleryModule]) => {
            // Astro hoists getStaticPaths into its own scope, so this validator has to be imported,
            // not declared alongside it in the frontmatter.
            assertGalleryModule(path, galleryModule)

            const { default: countryGallery, cityGalleries, sortDirection } = galleryModule
            const paths = await getGalleryStaticPaths({ cityGalleries, sortDirection })

            return paths.map(({ params, props }) => ({
                params: {
                    country: countryGallery.countryId,
                    photos: params.photos,
                },
                props: {
                    ...props,
                    countryGallery,
                    cityGalleries,
                },
            }))
        }),
    )

    return galleryPaths.flat()
}
---

<GalleryPage {...Astro.props} />
