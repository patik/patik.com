---
import GalleryPage from '@src/components/gallery/GalleryPage.astro'
import countryGallery, { cityGalleries } from '@src/galleries/vietnam'
import getGalleryStaticPaths, { type GalleryPath } from '@src/photos/utils/getGalleryStaticPaths'

export async function getStaticPaths(): Promise<GalleryPath[]> {
    return getGalleryStaticPaths({ cityGalleries })
}
---

<GalleryPage {...Astro.props} countryGallery={countryGallery} cityGalleries={cityGalleries} />
