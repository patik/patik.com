---
import PhotoGrid from '@src/components/gallery/PhotoGrid.astro'
import PhotoLightbox from '@src/components/gallery/PhotoLightbox.astro'
import countryGallery, { cityGalleries } from '@src/galleries/vietnam'
import Layout from '@src/layouts/Layout.astro'
import fetchFolderFromAssetProvider from '@src/photos/utils/fetchFolderFromAssetProvider'
import type { CloundinaryResource, ImageProps } from '@src/photos/utils/types'

export async function getStaticPaths() {
    const paths: Array<{
        params: { photos: string | undefined }
        props: { images: ImageProps[]; currentPhoto: ImageProps | null; cityId: string | null }
    }> = []

    function toImageProps(resource: CloundinaryResource, index: number): ImageProps {
        return {
            id: index,
            height: resource.height,
            width: resource.width,
            public_id: resource.public_id,
            format: resource.format,
            secure_url: resource.secure_url,
            resource_type: resource.resource_type,
        }
    }

    const cityImagesMap: Record<string, ImageProps[]> = {}

    await Promise.all(
        cityGalleries.map(async (city) => {
            try {
                const results = await fetchFolderFromAssetProvider(city.cloudinaryFolder, 'asc')
                cityImagesMap[city.cityId] = results.resources.map(toImageProps)
            } catch (e) {
                console.error(`[getStaticPaths] Error fetching ${city.cityId}:`, e)
                cityImagesMap[city.cityId] = []
            }
        }),
    )

    const allImages = Object.values(cityImagesMap)
        .flat()
        .map((img, i) => ({ ...img, id: i }))

    // Country gallery index: /travel/vietnam/photos/
    paths.push({
        params: { photos: undefined },
        props: { images: allImages, currentPhoto: null, cityId: null },
    })

    // Individual photos at country level: /travel/vietnam/photos/0, /travel/vietnam/photos/1, etc.
    for (let i = 0; i < allImages.length; i++) {
        paths.push({
            params: { photos: `${i}` },
            props: { images: allImages, currentPhoto: allImages[i], cityId: null },
        })
    }

    // City gallery pages
    for (const city of cityGalleries) {
        const cityImages = cityImagesMap[city.cityId] || []

        // City index: /travel/vietnam/photos/hanoi/
        paths.push({
            params: { photos: city.cityId },
            props: { images: cityImages, currentPhoto: null, cityId: city.cityId },
        })

        // Individual photos: /travel/vietnam/photos/hanoi/0, etc.
        for (let i = 0; i < cityImages.length; i++) {
            paths.push({
                params: { photos: `${city.cityId}/${i}` },
                props: { images: cityImages, currentPhoto: cityImages[i], cityId: city.cityId },
            })
        }
    }

    return paths
}

const { images, currentPhoto, cityId } = Astro.props

let gallery = countryGallery
let pageTitle = countryGallery.title

if (cityId) {
    const cityGallery = cityGalleries.find((g) => g.cityId === cityId)
    if (cityGallery) {
        gallery = cityGallery
        pageTitle = cityGallery.title
    }
}

const baseUrl = cityId ? `/travel/vietnam/photos/${cityId}/` : '/travel/vietnam/photos/'
---

<Layout title={pageTitle} keywords={gallery.keywords}>
    {
        currentPhoto ? (
            <PhotoLightbox currentPhoto={currentPhoto} images={images} galleryTitle={gallery.title} baseUrl={baseUrl} />
        ) : (
            <main class="gallery-page">
                <header class="gallery-header">
                    <h1>{gallery.title}</h1>
                    <a href={`/travel/${countryGallery.countryId}`} class="back-link">
                        ← Back to {countryGallery.countryName}
                    </a>
                </header>

                <PhotoGrid images={images} baseUrl={baseUrl} />
            </main>
        )
    }
</Layout>

<style>
    .gallery-page {
        max-width: 1600px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    .gallery-header {
        margin-bottom: 2rem;
    }

    .gallery-header h1 {
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
    }

    .back-link {
        color: rgba(var(--foreground-rgb), 0.6);
        text-decoration: none;
        font-size: 0.9rem;
        transition: color 0.2s;
    }

    .back-link:hover {
        color: rgb(var(--foreground-rgb));
    }
</style>
