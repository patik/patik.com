---
import CountriesOverview from '@src/components/countries/CountriesOverview.astro'
import { travelLinks } from '@src/travelLinks'
import TravelLinkList from '../components/TravelLinkList.astro'
import countries from '../countries.json'
import Layout from '../layouts/Layout.astro'
---

<Layout title="Travel" keywords={[...countries.visited.map((country) => country.name), 'Europe', 'Asia', 'travel']}>
    <header class="travel-page-header">
        <h1>Travel</h1>
        <a href="#photos">Jump to photos</a>
    </header>

    <section style={{ marginBottom: '3rem' }}>
        <h2>Countries I’ve been to</h2>
        <CountriesOverview />
    </section>

    <section class="flex flex-col gap-3">
        <h2 id="photos">Photos</h2>
        <TravelLinkList items={travelLinks} />
        <p>
            <em>Not shown: many notable trips since 2012, including Southeast Asia and much more of Europe</em>
        </p>
    </section>
</Layout>
