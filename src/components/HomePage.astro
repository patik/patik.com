---
import Space from '@src/components/Space'
import WorldMap from '@src/components/WorldMap.astro'
import countries from '@src/countries.json'
import GithubLogo from '@src/images/home-github-logo.png'
import LinkedInLogo from '@src/images/home-linkedin-logo.png'
import BlueskyLogo from '@src/images/icons/social/bluesky.svg'
import MailIcon from '@src/images/icons/social/mail.svg'
import MastodonLogo from '@src/images/icons/social/mastodon.svg'
import imgDovetailHeroDark from '@src/images/portfolio/dovetail-hero-dark.webp'
import imgDovetailHeroLight from '@src/images/portfolio/dovetail-hero-light.webp'
import { travelLinks } from '@src/travelLinks'
import { Image } from 'astro:assets'
import css from './HomePage.module.css'

const featuredTravelLinks = travelLinks.slice(0, 8)

const contactLinks = [
    { label: 'Email', href: 'mailto:craig@patik.com', icon: MailIcon },
    { label: 'GitHub', href: 'https://github.com/patik', icon: GithubLogo },
    { label: 'LinkedIn', href: 'https://www.linkedin.com/in/craigpatik', icon: LinkedInLogo },
    { label: 'Bluesky', href: 'https://bsky.app/profile/craig.patik.com', icon: BlueskyLogo },
    { label: 'Mastodon', href: 'https://mastodon.online/@craigpatik', icon: MastodonLogo },
]
---

<div class={css.home}>
    <section class={css.travelSection}>
        <div class={css.travelRow}>
            <div class={css.leftCol}>
                <header class={css.header}>
                    <h1>Craig Patik</h1>
                    <p class={css.intro}>
                        Staff Frontend Engineer at
                        <Space />
                        <a href="https://www.internations.org/">InterNations</a>, based in Munich, Germany. I’ve visited
                        <Space />{countries.visited.length} countries and counting.
                    </p>
                </header>

                <div class={css.mapColumn}>
                    <h2 class={css.mapHead}>
                        <a href="/travel/">Where I’ve been <span aria-hidden="true">→</span></a>
                    </h2>
                    <a class={css.mapCard} href="/travel/" aria-label="See the full travel page">
                        <WorldMap className={css.map} />
                    </a>
                </div>
            </div>

            <div class={css.tripsPanel}>
                <div class={css.tripsHead}>
                    <h2>Travel galleries</h2>
                    <a href="/travel/">View all <span aria-hidden="true">→</span></a>
                </div>
                <div class={css.tripsGrid}>
                    {
                        featuredTravelLinks.map((travelLink) => (
                            <a class={css.tripCard} href={travelLink.url}>
                                <Image
                                    {...travelLink.imageAttributes}
                                    src={travelLink.imageSrc}
                                    alt={travelLink.imageAlt}
                                    width={320}
                                    class={css.tripImage}
                                />
                                <span class={css.tripCaption}>
                                    <span class={css.tripCountry}>{travelLink.title}</span>
                                </span>
                            </a>
                        ))
                    }
                </div>
            </div>
        </div>
    </section>

    <section class={css.spotlight}>
        <div class={css.spotlightMedia}>
            <span class={css.frame}>
                <span class={css.frameBar}>
                    <span class={css.frameDots} aria-hidden="true"><span></span><span></span><span></span></span>
                    <span class={css.frameTitle}>dovetail.travel</span>
                </span>
                <picture>
                    <source srcset={imgDovetailHeroDark.src} media="(prefers-color-scheme: dark)" type="image/webp" />
                    <Image
                        src={imgDovetailHeroLight}
                        alt="The Dovetail Travel Planner landing page"
                        widths={[800, 1200]}
                        sizes="(max-width: 900px) 100vw, 560px"
                    />
                </picture>
            </span>
        </div>
        <div class={css.spotlightText}>
            <p class={css.spotlightKicker}>Code &amp; projects</p>
            <h2>I build for the web</h2>
            <p class={css.spotlightPitch}>
                A trip-planning app built and run solo, developer tools carried across a decade of the JavaScript
                ecosystem, and open-source libraries with a few hundred stars between them.
            </p>
            <a class={css.spotlightButton} href="/portfolio/">
                View the portfolio <span aria-hidden="true">→</span>
            </a>
        </div>
    </section>

    <section class={css.contactSection}>
        <h2>Say hi</h2>
        <div class={css.pillRow}>
            {
                contactLinks.map((link) => (
                    <a class={css.pill} href={link.href} rel={link.href.startsWith('http') ? 'me' : undefined}>
                        <img src={link.icon.src} alt="" width="18" height="18" />
                        {link.label}
                    </a>
                ))
            }
        </div>
    </section>
</div>
