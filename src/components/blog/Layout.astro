---
import CommonLayout from '../../layouts/Layout.astro'
import css from './BlogLayout.module.css'
import UnpublishedAlert from './UnpublishedAlert'

interface Props {
    title?: string
    keywords?: string[]
    draft?: boolean
}

const { draft, ...commonLayoutProps } = Astro.props
---

<CommonLayout {...commonLayoutProps}>
    <slot name="head" slot="head" />
    <div class={css.layout}>
        {draft && <UnpublishedAlert />}
        {/* Not a `main` — CommonLayout provides one, and nesting them doubles its padding. */}
        <div>
            <slot />
        </div>
    </div>
</CommonLayout>
