---
import CommonLayout from '../../layouts/Layout.astro'
import UnpublishedAlert from './UnpublishedAlert'

interface Props {
    title?: string
    keywords?: string[]
    draft?: boolean
}

const { draft, ...commonLayoutProps } = Astro.props
---

<CommonLayout {...commonLayoutProps}>
    <slot name="head" slot="head" />
    <div class="min-h-screen">
        {draft && <UnpublishedAlert />}
        {
            /* Deliberately not a `main` element: CommonLayout already provides one, and
            nesting them duplicates the landmark and double-applies its width/padding. */
        }
        <div>
            <slot />
        </div>
    </div>
</CommonLayout>
