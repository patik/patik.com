---
import { formatConcertDate, type ConcertEvent } from './concerts'

interface Props {
    event: ConcertEvent
}

const { event } = Astro.props
const text = formatConcertDate(event)
---

{
    event.url ? (
        <a href={event.url} target="_blank" rel="noopener noreferrer">
            {text}
        </a>
    ) : (
        text
    )
}
