---
import concertsData from '@src/concerts.json'
import ArtistList from './ArtistList.astro'
import {
    filterOpeningActs,
    getArtistsByAppearanceCount,
    getArtistsByName,
    getConcertStats,
    getEventsByDate,
    normalizeConcertEvents,
} from './concerts'
import css from './ConcertsPage.module.css'
import EventList from './EventList.astro'

const concertEvents = normalizeConcertEvents(concertsData)
const concertEventsWithoutOpeners = filterOpeningActs(concertEvents, false)
const concertEventsWithOpeners = filterOpeningActs(concertEvents, true)
const concertStatsWithoutOpeners = getConcertStats(concertEventsWithoutOpeners)
const concertStatsWithOpeners = getConcertStats(concertEventsWithOpeners)
const newestEventsWithoutOpeners = getEventsByDate(concertEventsWithoutOpeners, 'desc')
const oldestEventsWithoutOpeners = getEventsByDate(concertEventsWithoutOpeners, 'asc')
const newestEventsWithOpeners = getEventsByDate(concertEventsWithOpeners, 'desc')
const oldestEventsWithOpeners = getEventsByDate(concertEventsWithOpeners, 'asc')
const artistsByNameWithoutOpeners = getArtistsByName(concertEventsWithoutOpeners)
const artistsByNameWithOpeners = getArtistsByName(concertEventsWithOpeners)
const artistsByCountWithoutOpeners = getArtistsByAppearanceCount(concertEventsWithoutOpeners)
const artistsByCountWithOpeners = getArtistsByAppearanceCount(concertEventsWithOpeners)

const viewLabels = [
    {
        mode: 'date',
        label: 'Date',
        controls:
            'concerts-panel-date-desc-without-openers concerts-panel-date-asc-without-openers concerts-panel-date-desc-with-openers concerts-panel-date-asc-with-openers',
    },
    {
        mode: 'artist',
        label: 'Artist',
        controls: 'concerts-panel-artist-without-openers concerts-panel-artist-with-openers',
    },
    {
        mode: 'count',
        label: 'Times seen',
        controls: 'concerts-panel-count-without-openers concerts-panel-count-with-openers',
    },
]
---

<div class={css.concerts} data-concerts-root>
    <h1 id="concerts-heading">Concerts</h1>
    <div class={css.intro}>
        <p data-stats-panel="false">
            {concertStatsWithoutOpeners.eventCount} concerts, {concertStatsWithoutOpeners.artistCount} artists.
        </p>
        <p data-stats-panel="true" hidden>
            {concertStatsWithOpeners.eventCount} concerts, {concertStatsWithOpeners.artistCount} artists.
        </p>
    </div>

    <div class={css.toolbar}>
        <div class={css.segmentedControl} aria-label="Concert view">
            {
                viewLabels.map((view) => (
                    <button
                        type="button"
                        class={css.controlButton}
                        aria-pressed={view.mode === 'date' ? 'true' : 'false'}
                        aria-controls={view.controls}
                        data-view-button
                        data-view={view.mode}
                    >
                        {view.label}
                    </button>
                ))
            }
        </div>

        <div class={css.directionControl} aria-label="Date order" data-order-controls>
            <button
                type="button"
                class={css.controlButton}
                aria-pressed="true"
                aria-controls="concerts-panel-date-desc-without-openers concerts-panel-date-desc-with-openers"
                data-order-button
                data-order="desc"
            >
                Newest
            </button>
            <button
                type="button"
                class={css.controlButton}
                aria-pressed="false"
                aria-controls="concerts-panel-date-asc-without-openers concerts-panel-date-asc-with-openers"
                data-order-button
                data-order="asc"
                disabled
            >
                Oldest
            </button>
        </div>

        <label class={css.toggleControl}>
            <input type="checkbox" data-opening-acts-toggle />
            <span class={css.toggleSwitch} aria-hidden="true"></span>
            <span>Include opening acts</span>
        </label>
    </div>

    <section
        id="concerts-panel-date-desc-without-openers"
        aria-labelledby="concerts-view-heading-date-desc-without-openers"
        data-view-panel="date"
        data-order-panel="desc"
        data-openers-panel="false"
    >
        <h2 id="concerts-view-heading-date-desc-without-openers" class={css.viewTitle}>By date</h2>
        <EventList events={newestEventsWithoutOpeners} />
    </section>

    <section
        id="concerts-panel-date-asc-without-openers"
        aria-labelledby="concerts-view-heading-date-asc-without-openers"
        data-view-panel="date"
        data-order-panel="asc"
        data-openers-panel="false"
        hidden
    >
        <h2 id="concerts-view-heading-date-asc-without-openers" class={css.viewTitle}>By date</h2>
        <EventList events={oldestEventsWithoutOpeners} />
    </section>

    <section
        id="concerts-panel-date-desc-with-openers"
        aria-labelledby="concerts-view-heading-date-desc-with-openers"
        data-view-panel="date"
        data-order-panel="desc"
        data-openers-panel="true"
        hidden
    >
        <h2 id="concerts-view-heading-date-desc-with-openers" class={css.viewTitle}>By date</h2>
        <EventList events={newestEventsWithOpeners} />
    </section>

    <section
        id="concerts-panel-date-asc-with-openers"
        aria-labelledby="concerts-view-heading-date-asc-with-openers"
        data-view-panel="date"
        data-order-panel="asc"
        data-openers-panel="true"
        hidden
    >
        <h2 id="concerts-view-heading-date-asc-with-openers" class={css.viewTitle}>By date</h2>
        <EventList events={oldestEventsWithOpeners} />
    </section>

    <section
        id="concerts-panel-artist-without-openers"
        aria-labelledby="concerts-view-heading-artist-without-openers"
        data-view-panel="artist"
        data-openers-panel="false"
        hidden
    >
        <h2 id="concerts-view-heading-artist-without-openers" class={css.viewTitle}>By artist</h2>
        <ArtistList artists={artistsByNameWithoutOpeners} metaMode="artist" />
    </section>

    <section
        id="concerts-panel-artist-with-openers"
        aria-labelledby="concerts-view-heading-artist-with-openers"
        data-view-panel="artist"
        data-openers-panel="true"
        hidden
    >
        <h2 id="concerts-view-heading-artist-with-openers" class={css.viewTitle}>By artist</h2>
        <ArtistList artists={artistsByNameWithOpeners} metaMode="artist" />
    </section>

    <section
        id="concerts-panel-count-without-openers"
        aria-labelledby="concerts-view-heading-count-without-openers"
        data-view-panel="count"
        data-openers-panel="false"
        hidden
    >
        <h2 id="concerts-view-heading-count-without-openers" class={css.viewTitle}>By times seen</h2>
        <ArtistList artists={artistsByCountWithoutOpeners} metaMode="artist" variant="count" />
    </section>

    <section
        id="concerts-panel-count-with-openers"
        aria-labelledby="concerts-view-heading-count-with-openers"
        data-view-panel="count"
        data-openers-panel="true"
        hidden
    >
        <h2 id="concerts-view-heading-count-with-openers" class={css.viewTitle}>By times seen</h2>
        <ArtistList artists={artistsByCountWithOpeners} metaMode="artist" variant="count" />
    </section>
</div>

<script is:inline>
    const root = document.querySelector('[data-concerts-root]')

    if (root) {
        const viewButtons = [...root.querySelectorAll('[data-view-button]')]
        const orderButtons = [...root.querySelectorAll('[data-order-button]')]
        const viewPanels = [...root.querySelectorAll('[data-view-panel]')]
        const statsPanels = [...root.querySelectorAll('[data-stats-panel]')]
        const openingActsToggle = root.querySelector('[data-opening-acts-toggle]')
        const validViews = new Set(['date', 'artist', 'count'])
        const validOrders = new Set(['asc', 'desc'])

        const getInitialState = () => {
            const params = new URLSearchParams(window.location.search)
            const requestedView = params.get('view') ?? 'date'
            const requestedOrder = params.get('order') ?? 'desc'
            const view = validViews.has(requestedView) ? requestedView : 'date'
            const order = validOrders.has(requestedOrder) ? requestedOrder : 'desc'
            const includeOpeners = params.get('openers') === '1' || params.get('openers') === 'true'

            return { view, order, includeOpeners }
        }

        const replaceCurrentUrl = ({ view, order, includeOpeners }) => {
            const params = new URLSearchParams(window.location.search)
            params.set('view', view)

            if (view === 'date') {
                params.set('order', order)
            } else {
                params.delete('order')
            }

            if (includeOpeners) {
                params.set('openers', '1')
            } else {
                params.delete('openers')
            }

            const queryString = params.toString()
            const nextUrl = `${window.location.pathname}${queryString ? `?${queryString}` : ''}${window.location.hash}`
            window.history.replaceState(window.history.state, '', nextUrl)
        }

        const applyState = ({ view, order, includeOpeners }, shouldReplaceUrl = true) => {
            viewButtons.forEach((button) => {
                button.setAttribute('aria-pressed', button.dataset.view === view ? 'true' : 'false')
            })

            orderButtons.forEach((button) => {
                button.setAttribute('aria-pressed', button.dataset.order === order ? 'true' : 'false')
                button.disabled = view !== 'date'
            })

            if (openingActsToggle) {
                openingActsToggle.checked = includeOpeners
            }

            statsPanels.forEach((panel) => {
                panel.hidden = panel.dataset.statsPanel !== String(includeOpeners)
            })

            viewPanels.forEach((panel) => {
                const matchesView = panel.dataset.viewPanel === view
                const matchesOrder = !panel.dataset.orderPanel || panel.dataset.orderPanel === order
                const matchesOpeners = panel.dataset.openersPanel === String(includeOpeners)
                panel.hidden = !(matchesView && matchesOrder && matchesOpeners)
            })

            if (shouldReplaceUrl) {
                replaceCurrentUrl({ view, order, includeOpeners })
            }
        }

        let currentState = getInitialState()
        applyState(currentState, window.location.search !== '')

        viewButtons.forEach((button) => {
            button.addEventListener('click', () => {
                currentState = { ...currentState, view: button.dataset.view ?? 'date' }
                applyState(currentState)
            })
        })

        orderButtons.forEach((button) => {
            button.addEventListener('click', () => {
                currentState = { ...currentState, view: 'date', order: button.dataset.order ?? 'desc' }
                applyState(currentState)
            })
        })

        openingActsToggle?.addEventListener('change', () => {
            currentState = { ...currentState, includeOpeners: openingActsToggle.checked }
            applyState(currentState)
        })
    }
</script>
