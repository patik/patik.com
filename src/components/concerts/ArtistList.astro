---
import {
    formatConcertDate,
    getArtistLatestAppearance,
    getRoleLabel,
    type ArtistSummary,
    type ConcertRole,
} from './concerts'
import css from './ConcertsPage.module.css'

interface Props {
    artists: ArtistSummary[]
    variant?: 'default' | 'count'
    metaMode?: 'artist' | 'date'
}

const { artists, variant = 'default', metaMode = 'artist' } = Astro.props

function getRoleClassName(role: ConcertRole): string {
    switch (role) {
        case 'main':
            return css.roleMain
        case 'festival':
            return css.roleFestival
        case 'opener':
            return css.roleOpener
    }
}

function formatArtistBreakdown(artist: ArtistSummary): string {
    const parts = [
        formatCount(artist.mainAppearances, 'main'),
        formatCount(artist.festivalAppearances, 'festival'),
        formatCount(artist.openerAppearances, 'support'),
    ].filter(Boolean)

    return parts.join(' / ')
}

function formatCount(count: number, label: string): string {
    if (count === 0) {
        return ''
    }

    return `${count} ${label}`
}

function getMetaText(artist: ArtistSummary): string {
    if (metaMode === 'date') {
        const latestAppearance = getArtistLatestAppearance(artist)

        if (!latestAppearance) {
            return formatArtistBreakdown(artist)
        }

        return `${formatConcertDate(latestAppearance.event)} • ${formatArtistBreakdown(artist)}`
    }

    return formatArtistBreakdown(artist)
}
---

<ol class:list={[css.artistList, { [css.artistListCount]: variant === 'count' }]}>
    {
        artists.map((artist) => (
            <li>
                <article class:list={[css.artistCard, { [css.artistCardCount]: variant === 'count' }]}>
                    <div class={css.artistHeader}>
                        <div>
                            <h3 class={css.artistName}>{artist.name}</h3>
                            <p class={css.artistMeta}>{getMetaText(artist)}</p>
                        </div>

                        <div
                            class:list={[css.countBadge, { [css.countBadgeCount]: variant === 'count' }]}
                            aria-label={`${artist.totalAppearances} appearances`}
                        >
                            <span class={css.countNumber}>{artist.totalAppearances}</span>
                            <span class={css.countLabel}>{artist.totalAppearances === 1 ? 'time' : 'times'}</span>
                        </div>
                    </div>

                    <ol class={css.appearanceList}>
                        {artist.appearances.map((appearance) => (
                            <li class={css.appearanceItem}>
                                <span class={`${css.appearanceRole} ${getRoleClassName(appearance.role)}`}>
                                    {getRoleLabel(appearance.role)}
                                </span>
                                <span class={css.appearanceMeta}>
                                    {formatConcertDate(appearance.event)} at{' '}
                                    {appearance.event.festival ?? appearance.event.venue}
                                </span>
                            </li>
                        ))}
                    </ol>
                </article>
            </li>
        ))
    }
</ol>
