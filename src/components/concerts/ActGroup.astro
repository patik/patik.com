---
import type { ConcertAct, ConcertRole } from './concerts'
import css from './ConcertsPage.module.css'

interface Props {
    title: string
    acts: ConcertAct[]
    concertRole: ConcertRole
}

const { title, acts, concertRole } = Astro.props

function getRoleClassName(role: ConcertRole): string {
    switch (role) {
        case 'main':
            return css.roleMain
        case 'festival':
            return css.roleFestival
        case 'opener':
            return css.roleOpener
    }
}
---

{
    acts.length > 0 ? (
        <div class={css.roleGroup}>
            <h4 class={css.roleHeading}>{title}</h4>
            <ul class={css.actList}>
                {acts.map((act) => (
                    <li>
                        <span class={`${css.actPill} ${getRoleClassName(concertRole)}`}>{act.name}</span>
                    </li>
                ))}
            </ul>
        </div>
    ) : null
}
