---
import getImageUrl from '@src/photos/utils/getImageUrl'
import type { ImageProps } from '@src/photos/utils/types'
import css from './PhotoGrid.module.css'

interface Props {
    images: ImageProps[]
    baseUrl: string
}

const { images, baseUrl } = Astro.props
---

<div class={css.grid}>
    {
        images.map((image) => {
            // const url = getImageUrl(image, 800)
            const thumbUrl = getImageUrl(image, 400)

            return (
                <a href={`${baseUrl}${image.id}`} class={css.item} data-photo-id={image.id}>
                    <img
                        src={thumbUrl}
                        alt={`Photo ${image.id + 1}`}
                        loading="lazy"
                        width={image.width}
                        height={image.height}
                        style={`aspect-ratio: ${image.width} / ${image.height}`}
                    />
                </a>
            )
        })
    }
</div>
