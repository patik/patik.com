---
import getImageUrl from '@src/photos/utils/getImageUrl'
import type { ImageProps } from '@src/photos/utils/types'
import css from './PhotoLightbox.module.css'

interface Props {
    currentPhoto: ImageProps
    images: ImageProps[]
    galleryTitle: string
    baseUrl: string
}

const { currentPhoto, images, galleryTitle, baseUrl } = Astro.props

const currentIndex = images.findIndex((img) => img.id === currentPhoto.id)
const prevPhoto = currentIndex > 0 ? images[currentIndex - 1] : null
const nextPhoto = currentIndex < images.length - 1 ? images[currentIndex + 1] : null

const currentImageUrl = getImageUrl(currentPhoto, 1600)
---

<div class:list={[css.page, 'lightbox-page']}>
    <nav class={css.nav}>
        <a href={baseUrl.replace(/\/$/, '')} class={css.backLink}>
            ← Back to {galleryTitle}
        </a>
    </nav>

    <div class={css.container}>
        <div class={css.main}>
            <img
                src={currentImageUrl}
                alt={`Photo ${currentPhoto.id + 1}`}
                width={currentPhoto.width}
                height={currentPhoto.height}
                class={css.mainImage}
            />
        </div>

        <div class={css.controls}>
            {
                prevPhoto ? (
                    <a href={`${baseUrl}${prevPhoto.id}`} class={css.navButton} data-direction="prev">
                        <span aria-hidden="true">←</span>
                        <span class={css.srOnly}>Previous photo</span>
                    </a>
                ) : (
                    <div class={css.navButtonPlaceholder} />
                )
            }

            <div class={css.counter}>
                {currentIndex + 1} / {images.length}
            </div>

            {
                nextPhoto ? (
                    <a href={`${baseUrl}${nextPhoto.id}`} class={css.navButton} data-direction="next">
                        <span aria-hidden="true">→</span>
                        <span class={css.srOnly}>Next photo</span>
                    </a>
                ) : (
                    <div class={css.navButtonPlaceholder} />
                )
            }
        </div>
    </div>
</div>

<script define:vars={{ prevPhoto, nextPhoto, baseUrl }} is:inline>
    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft' && prevPhoto) {
            window.location.href = `${baseUrl}${prevPhoto.id}`
        } else if (e.key === 'ArrowRight' && nextPhoto) {
            window.location.href = `${baseUrl}${nextPhoto.id}`
        } else if (e.key === 'Escape') {
            window.location.href = baseUrl.replace(/\/$/, '')
        }
    })
</script>
