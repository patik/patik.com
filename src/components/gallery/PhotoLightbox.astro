---
import getImageUrl from '@src/photos/utils/getImageUrl'
import type { ImageProps } from '@src/photos/utils/types'

interface Props {
    currentPhoto: ImageProps
    images: ImageProps[]
    galleryTitle: string
    baseUrl: string
}

const { currentPhoto, images, galleryTitle, baseUrl } = Astro.props

const currentIndex = images.findIndex((img) => img.id === currentPhoto.id)
const prevPhoto = currentIndex > 0 ? images[currentIndex - 1] : null
const nextPhoto = currentIndex < images.length - 1 ? images[currentIndex + 1] : null

const currentImageUrl = getImageUrl(currentPhoto, 1600)
---

<div class="lightbox-page">
    <nav class="lightbox-nav">
        <a href={baseUrl.replace(/\/$/, '')} class="back-link">
            ← Back to {galleryTitle}
        </a>
    </nav>

    <div class="lightbox-container">
        <div class="lightbox-main">
            <img
                src={currentImageUrl}
                alt={`Photo ${currentPhoto.id + 1}`}
                width={currentPhoto.width}
                height={currentPhoto.height}
                class="main-image"
            />
        </div>

        <div class="lightbox-controls">
            {
                prevPhoto ? (
                    <a href={`${baseUrl}${prevPhoto.id}`} class="nav-button prev-button" data-direction="prev">
                        <span aria-hidden="true">←</span>
                        <span class="sr-only">Previous photo</span>
                    </a>
                ) : (
                    <div class="nav-button-placeholder" />
                )
            }

            <div class="photo-counter">
                {currentIndex + 1} / {images.length}
            </div>

            {
                nextPhoto ? (
                    <a href={`${baseUrl}${nextPhoto.id}`} class="nav-button next-button" data-direction="next">
                        <span aria-hidden="true">→</span>
                        <span class="sr-only">Next photo</span>
                    </a>
                ) : (
                    <div class="nav-button-placeholder" />
                )
            }
        </div>
    </div>
</div>

<script define:vars={{ prevPhoto, nextPhoto, baseUrl }} is:inline>
    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft' && prevPhoto) {
            window.location.href = `${baseUrl}${prevPhoto.id}`
        } else if (e.key === 'ArrowRight' && nextPhoto) {
            window.location.href = `${baseUrl}${nextPhoto.id}`
        } else if (e.key === 'Escape') {
            window.location.href = baseUrl.replace(/\/$/, '')
        }
    })
</script>

<style>
    .lightbox-page {
        min-height: 100vh;
        background: #000;
        color: #fff;
        display: flex;
        flex-direction: column;
    }

    .lightbox-nav {
        padding: 1rem;
        background: rgba(0, 0, 0, 0.8);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .back-link {
        color: #fff;
        text-decoration: none;
        font-size: 0.9rem;
        opacity: 0.8;
        transition: opacity 0.2s;
    }

    .back-link:hover {
        opacity: 1;
    }

    .lightbox-container {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 1rem;
    }

    .lightbox-main {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        max-width: 1600px;
    }

    .main-image {
        max-width: 100%;
        max-height: calc(100vh - 150px);
        width: auto;
        height: auto;
        object-fit: contain;
    }

    .lightbox-controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2rem;
        padding: 2rem 1rem;
        width: 100%;
        max-width: 600px;
    }

    .nav-button,
    .nav-button-placeholder {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        color: #fff;
        text-decoration: none;
        transition: all 0.2s;
        cursor: pointer;
    }

    .nav-button-placeholder {
        opacity: 0;
        cursor: default;
    }

    .nav-button:hover {
        background: rgba(255, 255, 255, 0.2);
        border-color: rgba(255, 255, 255, 0.4);
        transform: scale(1.1);
    }

    .photo-counter {
        font-size: 0.9rem;
        opacity: 0.7;
        min-width: 80px;
        text-align: center;
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
    }

    @media (max-width: 640px) {
        .lightbox-controls {
            gap: 1rem;
        }

        .nav-button {
            width: 40px;
            height: 40px;
            font-size: 20px;
        }
    }
</style>
