---
import PhotoGrid from '@src/components/gallery/PhotoGrid.astro'
import PhotoLightbox from '@src/components/gallery/PhotoLightbox.astro'
import Layout from '@src/layouts/Layout.astro'
import css from './GalleryPage.module.css'
import type { GalleryPageProps } from '@src/photos/utils/getGalleryStaticPaths'
import type { CityGallery, CountryGallery } from '@src/photos/utils/types'

interface Props extends GalleryPageProps {
    countryGallery: CountryGallery
    cityGalleries: CityGallery[]
}

const { images, currentPhoto, cityId, countryGallery, cityGalleries } = Astro.props

const cityGallery = cityId ? cityGalleries.find((g) => g.cityId === cityId) : undefined
const gallery = cityGallery ?? countryGallery
const baseUrl = cityId
    ? `/travel/${countryGallery.countryId}/photos/${cityId}/`
    : `/travel/${countryGallery.countryId}/photos/`
---

<Layout title={gallery.title} keywords={gallery.keywords}>
    {
        currentPhoto ? (
            <PhotoLightbox currentPhoto={currentPhoto} images={images} galleryTitle={gallery.title} baseUrl={baseUrl} />
        ) : (
            <>
                <header class={css.header}>
                    <h1>{gallery.title}</h1>
                    <a href={`/travel/${countryGallery.countryId}`} class={css.backLink}>
                        ← Back to {countryGallery.countryName}
                    </a>
                </header>

                <PhotoGrid images={images} baseUrl={baseUrl} />
            </>
        )
    }
</Layout>
