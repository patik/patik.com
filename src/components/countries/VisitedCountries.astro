---
import countriesData from '@src/countries.json'
import { getCountriesViewData } from './countries'
import { DEFAULT_SORT } from './visitedCountries'
import css from './VisitedCountries.module.css'
import VisitedCountriesPanels from './VisitedCountriesPanels.astro'
import VisitedCountriesSummaries from './VisitedCountriesSummaries.astro'
import VisitedCountriesToolbar from './VisitedCountriesToolbar.astro'

const currentYear = new Date().getFullYear()
const { byResidenceFilter } = getCountriesViewData({ countries: countriesData.visited, currentYear })
---

<visited-countries class={css.countries} data-default-sort={DEFAULT_SORT}>
    <VisitedCountriesSummaries byResidenceFilter={byResidenceFilter} />
    <VisitedCountriesToolbar />
    <VisitedCountriesPanels byResidenceFilter={byResidenceFilter} />
</visited-countries>

<script>
    import './VisitedCountries.client'
</script>
