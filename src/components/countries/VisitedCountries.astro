---
import countriesData from '@src/countries.json'
import { getCountriesViewData, getCountryFlag, type CountrySortMode, type ResidenceFilter } from './countries'
import CountryList from './CountryList.astro'
import css from './VisitedCountries.module.css'

interface SortOption {
    mode: CountrySortMode
    label: string
    heading: string
    isDefault?: boolean
}

interface ResidenceState {
    filter: ResidenceFilter
    isDefault?: boolean
}

const currentYear = new Date().getFullYear()
const { byResidenceFilter } = getCountriesViewData({ countries: countriesData.visited, currentYear })

const sortOptions: SortOption[] = [
    { mode: 'recent', label: 'Most recent', heading: 'most recent visit', isDefault: true },
    { mode: 'visits', label: 'Most visits', heading: 'number of visits' },
    { mode: 'first', label: 'First visit', heading: 'first visit' },
    { mode: 'name', label: 'A–Z', heading: 'name' },
]

// The default (and only build-time-visible) panel includes lived-in countries.
const residenceStates: ResidenceState[] = [{ filter: 'excludingResidences' }, { filter: 'all', isDefault: true }]

const defaultSort = sortOptions.find((option) => option.isDefault)?.mode ?? 'recent'
const defaultResidenceFilter = residenceStates.find((state) => state.isDefault)?.filter ?? 'all'
const scrollRegionId = 'countries-scroll'
const toolbarId = 'countries-toolbar'
const defaultSortLabel = sortOptions.find((option) => option.isDefault)?.label ?? sortOptions[0].label

const countsByFilter = Object.fromEntries(
    residenceStates.map((state) => [state.filter, byResidenceFilter[state.filter].stats.countryCount]),
) as Record<ResidenceFilter, number>

function getPanelId(filter: ResidenceFilter, mode: CountrySortMode): string {
    return `countries-panel-${filter}-${mode}`
}

function getSortControls(mode: CountrySortMode): string {
    return residenceStates.map((state) => getPanelId(state.filter, mode)).join(' ')
}
---

<div class={css.countries} data-countries-root data-default-sort={defaultSort} data-list-expanded="false">
    {
        residenceStates.map((state) => {
            const { stats } = byResidenceFilter[state.filter]

            return (
                <p class={css.summary} data-residence-summary={state.filter} hidden={!state.isDefault}>
                    <strong>{stats.countryCount}</strong> countries · <strong>{stats.visitCount}</strong> visits ·{' '}
                    {stats.yearRange}
                    <span class={css.summaryDetail}>
                        Most visits:{' '}
                        {getCountryFlag(stats.mostVisited.name) ? (
                            <span aria-hidden="true" class={css.flag}>
                                {getCountryFlag(stats.mostVisited.name)}
                            </span>
                        ) : null}
                        {stats.mostVisited.name} ({stats.mostVisited.visitCount})
                    </span>
                </p>
            )
        })
    }

    <button
        type="button"
        class={css.filtersToggle}
        data-filters-toggle
        aria-expanded="false"
        aria-controls={toolbarId}
        data-default-sort-label={defaultSortLabel}
    >
        {`Filters: ${defaultSortLabel}`}
    </button>

    <div id={toolbarId} class={css.toolbar} hidden>
        <div class={css.segmented} role="group" aria-label="Sort countries">
            {
                sortOptions.map((option) => (
                    <button
                        type="button"
                        class={css.sortButton}
                        aria-pressed={option.isDefault ? 'true' : 'false'}
                        aria-controls={getSortControls(option.mode)}
                        data-sort-button
                        data-sort={option.mode}
                        data-label={option.label}
                    >
                        {option.label}
                    </button>
                ))
            }
        </div>

        <label class={css.toggleControl}>
            <input type="checkbox" data-residence-toggle switch checked={defaultResidenceFilter === 'all'} />
            <span class={css.toggleSwitch} aria-hidden="true"></span>
            <span>Include countries I’ve lived in</span>
        </label>
    </div>

    <div id={scrollRegionId} class={css.scroll} tabindex="0" role="region" aria-label="Country list">
        {
            residenceStates.map((state) =>
                sortOptions.map((option) => (
                    <section
                        id={getPanelId(state.filter, option.mode)}
                        aria-label={`Countries by ${option.heading}`}
                        data-sort-panel={option.mode}
                        data-residence-panel={state.filter}
                        hidden={!(state.isDefault && option.isDefault)}
                    >
                        <CountryList countries={byResidenceFilter[state.filter].countriesBySort[option.mode]} />
                    </section>
                )),
            )
        }
        <div class={css.scrollFade} aria-hidden="true" />
    </div>

    <button
        type="button"
        class={css.expandToggle}
        data-list-expand-toggle
        aria-expanded="false"
        aria-controls={scrollRegionId}
        data-count-excluding-residences={countsByFilter.excludingResidences}
        data-count-all={countsByFilter.all}
    >
        {`Show all ${countsByFilter[defaultResidenceFilter]} countries`}
    </button>
</div>

<script is:inline>
    const root = document.querySelector('[data-countries-root]')

    if (root) {
        const sortButtons = [...root.querySelectorAll('[data-sort-button]')]
        const sortPanels = [...root.querySelectorAll('[data-sort-panel]')]
        const summaries = [...root.querySelectorAll('[data-residence-summary]')]
        const residenceToggle = root.querySelector('[data-residence-toggle]')
        const expandToggle = root.querySelector('[data-list-expand-toggle]')
        const scrollRegion = expandToggle ? document.getElementById(expandToggle.getAttribute('aria-controls')) : null
        const filtersToggle = root.querySelector('[data-filters-toggle]')
        const toolbar = filtersToggle ? document.getElementById(filtersToggle.getAttribute('aria-controls')) : null
        const validSorts = new Set(sortPanels.map((panel) => panel.dataset.sortPanel))
        const defaultSort = root.dataset.defaultSort

        const getExpandLabel = (isExpanded, residenceFilter) => {
            if (isExpanded) {
                return 'Collapse list'
            }

            const count =
                residenceFilter === 'excludingResidences'
                    ? expandToggle.dataset.countExcludingResidences
                    : expandToggle.dataset.countAll

            return `Show all ${count} countries`
        }

        const getFiltersLabel = (isFiltersExpanded, sort) => {
            if (isFiltersExpanded) {
                return 'Hide filters'
            }

            const activeButton = sortButtons.find((button) => button.dataset.sort === sort)

            return `Filters: ${activeButton?.dataset.label ?? filtersToggle.dataset.defaultSortLabel}`
        }

        const applyState = (state, shouldUpdateUrl) => {
            const residenceFilter = state.excludeResidences ? 'excludingResidences' : 'all'

            sortButtons.forEach((button) => {
                button.setAttribute('aria-pressed', button.dataset.sort === state.sort ? 'true' : 'false')
            })

            if (residenceToggle) {
                residenceToggle.checked = !state.excludeResidences
            }

            summaries.forEach((summary) => {
                summary.hidden = summary.dataset.residenceSummary !== residenceFilter
            })

            sortPanels.forEach((panel) => {
                const matchesSort = panel.dataset.sortPanel === state.sort
                const matchesResidence = panel.dataset.residencePanel === residenceFilter
                panel.hidden = !(matchesSort && matchesResidence)
            })

            if (expandToggle) {
                const isExpanded = root.dataset.listExpanded === 'true'
                expandToggle.textContent = getExpandLabel(isExpanded, residenceFilter)
            }

            if (filtersToggle) {
                const isFiltersExpanded = filtersToggle.getAttribute('aria-expanded') === 'true'
                filtersToggle.textContent = getFiltersLabel(isFiltersExpanded, state.sort)
            }

            if (shouldUpdateUrl) {
                const params = new URLSearchParams(window.location.search)

                if (state.sort === defaultSort) {
                    params.delete('sort')
                } else {
                    params.set('sort', state.sort)
                }

                if (state.excludeResidences) {
                    params.set('lived', '0')
                } else {
                    params.delete('lived')
                }

                const queryString = params.toString()
                const nextUrl = `${window.location.pathname}${queryString ? `?${queryString}` : ''}${window.location.hash}`
                window.history.replaceState(window.history.state, '', nextUrl)
            }
        }

        const params = new URLSearchParams(window.location.search)
        const requestedSort = params.get('sort')
        const currentState = {
            sort: requestedSort && validSorts.has(requestedSort) ? requestedSort : defaultSort,
            excludeResidences: params.get('lived') === '0',
        }

        // Start with the filters expanded when the URL requests a non-default sort or
        // residence filter, so the visible control matches the state it's showing.
        if (filtersToggle && toolbar && (currentState.sort !== defaultSort || currentState.excludeResidences)) {
            toolbar.hidden = false
            filtersToggle.setAttribute('aria-expanded', 'true')
        }

        applyState(currentState, false)

        sortButtons.forEach((button) => {
            button.addEventListener('click', () => {
                currentState.sort = button.dataset.sort
                applyState(currentState, true)
            })
        })

        residenceToggle?.addEventListener('change', () => {
            currentState.excludeResidences = !residenceToggle.checked
            applyState(currentState, true)
        })

        filtersToggle?.addEventListener('click', () => {
            const isExpanded = filtersToggle.getAttribute('aria-expanded') !== 'true'

            filtersToggle.setAttribute('aria-expanded', String(isExpanded))

            if (toolbar) {
                toolbar.hidden = !isExpanded
            }

            filtersToggle.textContent = getFiltersLabel(isExpanded, currentState.sort)
        })

        expandToggle?.addEventListener('click', () => {
            const isExpanded = root.dataset.listExpanded !== 'true'

            root.dataset.listExpanded = String(isExpanded)
            expandToggle.setAttribute('aria-expanded', String(isExpanded))

            if (scrollRegion) {
                if (isExpanded) {
                    scrollRegion.removeAttribute('tabindex')
                } else {
                    scrollRegion.setAttribute('tabindex', '0')
                }
            }

            const residenceFilter = currentState.excludeResidences ? 'excludingResidences' : 'all'
            expandToggle.textContent = getExpandLabel(isExpanded, residenceFilter)
        })
    }
</script>
