---
import type { CountriesViewData } from './countries'
import CountryList from './CountryList.astro'
import { getPanelId, RESIDENCE_STATES, SCROLL_REGION_ID, SORT_OPTIONS } from './visitedCountries'
import css from './VisitedCountries.module.css'

interface Props {
    byResidenceFilter: CountriesViewData['byResidenceFilter']
}

const { byResidenceFilter } = Astro.props
---

<div id={SCROLL_REGION_ID} class={css.scroll} tabindex="0" role="region" aria-label="Country list">
    {
        RESIDENCE_STATES.map((state) => (
            <div class={css.residencePanels} data-residence-panels={state.filter}>
                {SORT_OPTIONS.map((option) => (
                    <section
                        id={getPanelId(state.filter, option.mode)}
                        class={css.sortPanel}
                        aria-label={`Countries by ${option.heading}`}
                        data-sort-panel={option.mode}
                    >
                        <CountryList countries={byResidenceFilter[state.filter].countriesBySort[option.mode]} />
                    </section>
                ))}
            </div>
        ))
    }
    <div class={css.scrollFade} aria-hidden="true"></div>
</div>
