---
import Space from '@src/components/Space'
import imgConsoleLogIcon from '@src/images/icons/console-log/ios/AppIcon@3x.png'
import imgKindjsIcon from '@src/images/icons/kindjs/ios/AppIcon@3x.png'
import imgWithinViewportIcon from '@src/images/icons/within-viewport/ios/AppIcon@3x.png'
import imgDofApp from '@src/images/portfolio/dof-app.webp'
import imgGinMain from '@src/images/portfolio/gin-main.webp'
import imgIncMain from '@src/images/portfolio/inc-main.webp'
import { getPullRequests } from '@src/utils/getPullRequests'
import { Image } from 'astro:assets'
import css from './PortfolioPage.module.css'

/** The contents list and the headings below both read from this, so they can't drift apart. */
const sections = [
    { id: 'dovetail', number: '01', label: 'Dovetail Travel Planner' },
    { id: 'internal-developer-tools', number: '02', label: 'Internal developer tools' },
    { id: 'command-line-tools', number: '03', label: 'Command-line tools' },
    { id: 'apps-and-sites', number: '04', label: 'Apps & sites' },
    { id: 'libraries', number: '05', label: 'Libraries' },
    { id: 'writing', number: '06', label: 'Writing' },
    { id: 'contributions', number: '07', label: 'Contributions' },
    { id: 'earlier-era', number: '08', label: 'From an earlier era' },
] as const

function section(id: (typeof sections)[number]['id']) {
    const match = sections.find((entry) => entry.id === id)

    if (!match) {
        throw new Error(`Unknown portfolio section: ${id}`)
    }

    return match
}

/**
 * The two Dovetail recordings. `media` drives which file the browser downloads, so the bands must
 * not overlap — 801px matches the CSS breakpoint below, which explains the off-by-one.
 */
const dovetailDemos = {
    desktop: {
        src: '/portfolio/media/dovetail-demo-desktop.mp4',
        poster: '/portfolio/media/dovetail-demo-desktop-poster.webp',
        media: '(min-width: 801px)',
    },
    mobile: {
        src: '/portfolio/media/dovetail-demo-mobile.mp4',
        poster: '/portfolio/media/dovetail-demo-mobile-poster.webp',
        media: '(max-width: 800px)',
    },
} as const

// Counted rather than written down, so this can't contradict the page it links to.
const pullRequests = await getPullRequests()
const pullRequestYears = pullRequests.map((entry) => entry.data.date.getUTCFullYear())
const pullRequestSpan = `${Math.min(...pullRequestYears)} – ${Math.max(...pullRequestYears)}`
---

<div class={css.portfolio}>
    <header class={css.header}>
        <p class={css.kicker}>Portfolio · 2000 – present</p>
        <h1>Code &amp; Projects</h1>
        <p class={css.deck}>
            I’m a Staff Frontend Engineer at <a href="https://www.internations.org/">InterNations</a> and I’ve been building
            for the web since 2000. This page collects selected work: a travel-planning product, internal developer tools,
            command-line tools, and open-source libraries—some of them maintained for well over a decade—plus a selection
            of the writing.
        </p>
        <div class:list={[css.headerStats, css.mono]}>
            <span>50+ repositories</span>
            <span>~700 stars</span>
            <a href="https://github.com/patik">github.com/patik <span aria-hidden="true">↗</span></a>
        </div>
    </header>

    <nav class={css.toc} aria-label="Sections of this page">
        {
            sections.map(({ id, number, label }) => (
                <a class={css.tocLink} href={`#${id}`}>
                    <span class={css.tocNumber} aria-hidden="true">
                        {number}
                    </span>
                    {label}
                </a>
            ))
        }
    </nav>

    <section id="dovetail" class={css.section}>
        <div class={css.sectionHead}>
            <h2>
                <span class={css.sectionNumber} aria-hidden="true">{section('dovetail').number} · Featured</span>
                {section('dovetail').label}
            </h2>
        </div>

        <div>
            <div class={css.frame}>
                <span class={css.frameBar}>
                    <span class={css.frameDots} aria-hidden="true"><span></span><span></span><span></span></span>
                    <span class={css.frameTitle}>dovetail.travel</span>
                </span>
                {/* Two recordings of the same trip, one per form factor. The `media` attributes mean the
                    browser only ever downloads the matching one; the script at the foot of this file
                    re-runs that choice on resize, which `media` alone does not do. */}
                <video
                    data-demo
                    class={css.dovetailDemo}
                    controls
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    poster={dovetailDemos.desktop.poster}
                    aria-label="Screen recording of planning a trip in Dovetail"
                >
                    {
                        Object.values(dovetailDemos).map(({ src, media, poster }) => (
                            <source src={src} type="video/mp4" media={media} data-poster={poster} />
                        ))
                    }
                </video>
            </div>

            <div class:list={[css.linkRow, css.dovetailAlternateLinks]}>
                <a class={css.shownBelowDemoBreakpoint} href={dovetailDemos.desktop.src}>Watch the desktop demo</a>
                <a class={css.shownAboveDemoBreakpoint} href={dovetailDemos.mobile.src}>Watch the mobile demo</a>
            </div>
        </div>

        <div class={css.featuredBody}>
            <div class={css.prose}>
                <p>
                    Dovetail is a complete product—design, engineering, and operations—built and run solo. It’s a
                    trip-planning calendar for hands-on travellers: day-by-day logistics with rich entry types, a trip
                    map, a wishlist for unscheduled ideas, and print-friendly itineraries. It runs on the web and as
                    native iOS and Android apps, with subscriptions handled across Stripe and the app stores.
                </p>
                <p>The source is closed, but the engineering is the interesting part:</p>
                <ul class={css.featuredList}>
                    <li>
                        <strong>Offline-first by design.</strong> Trips live in an IndexedDB cache with a sync queue, so the
                        app stays fully usable without a connection and reconciles with Supabase when it returns.
                    </li>
                    <li>
                        <strong>One TypeScript codebase, three platforms.</strong> React 19 on Vite, wrapped in thin Capacitor
                        shells that provide native auth, networking, and geolocation.
                    </li>
                    <li>
                        <strong>Tested like a team built it.</strong> A Playwright end-to-end suite runs against seeded IndexedDB
                        fixtures with a fake signed-in user, so CI needs no backend credentials.
                    </li>
                    <li>
                        <strong>Systematic theming.</strong> A design-token colour system keeps light and dark mode consistent
                        across web and native.
                    </li>
                </ul>
            </div>
            <div class={css.featuredFacts}>
                <p class={css.factLabel}>Role</p>
                <p class={css.factText}>Design, engineering, and operations—solo</p>
                <p class={css.factLabel}>Stack</p>
                <div class={css.tagRow}>
                    <span class={css.tag}>React 19</span>
                    <span class={css.tag}>TypeScript</span>
                    <span class={css.tag}>Vite</span>
                    <span class={css.tag}>TanStack Query</span>
                    <span class={css.tag}>Tailwind CSS 4</span>
                    <span class={css.tag}>Supabase</span>
                    <span class={css.tag}>IndexedDB</span>
                    <span class={css.tag}>Mapbox GL</span>
                    <span class={css.tag}>Capacitor</span>
                    <span class={css.tag}>Playwright</span>
                </div>
                <p class={css.factLabel}>Links</p>
                <div class={css.linkRow}>
                    <a href="https://dovetail.travel">dovetail.travel <span aria-hidden="true">↗</span></a>
                </div>
            </div>
        </div>
    </section>

    <section id="internal-developer-tools" class={css.section}>
        <div class={css.sectionHead}>
            <h2>
                <span class={css.sectionNumber} aria-hidden="true">{section('internal-developer-tools').number}</span>
                {section('internal-developer-tools').label}
            </h2>
            <p class={css.sectionNote}>
                Two tools I conceived, designed, and built end to end for InterNations. The source is private; the
                product work shown here is shared with permission.
            </p>
        </div>

        <div class={css.entries}>
            <div class={css.entry}>
                <div class:list={[css.entryMedia, css.mediaStack]}>
                    <a class={css.mediaLink} href={imgIncMain.src}>
                        <span class={css.frame}>
                            <span class={css.frameBar}>
                                <span class={css.frameDots} aria-hidden="true"
                                    ><span></span><span></span><span></span></span
                                >
                                <span class={css.frameTitle}>$ inc · command form and execution log</span>
                            </span>
                            <Image
                                src={imgIncMain}
                                alt="Inc showing a generated event form beside a searchable log of completed and failed development commands"
                                widths={[700, 1200, 1800]}
                                sizes="(max-width: 800px) 100vw, 530px"
                            />
                        </span>
                    </a>

                    <div class={css.frame}>
                        <div class={css.frameBar}>
                            <span class={css.frameDots} aria-hidden="true"><span></span><span></span><span></span></span
                            >
                            <span class={css.frameTitle}>$ inc completion install</span>
                        </div>
                        <video
                            data-demo
                            controls
                            muted
                            loop
                            playsinline
                            preload="metadata"
                            width="1200"
                            height="1092"
                            poster="/portfolio/media/inc-tab-completion-poster.webp"
                            aria-label="Screen recording of Inc tab-completing Symfony console command names"
                        >
                            <source src="/portfolio/media/inc-tab-completion.mp4" type="video/mp4" />
                        </video>
                    </div>
                </div>
                <div class={css.entryText}>
                    <h3>Inc</h3>
                    <div class:list={[css.entryMeta, css.mono]}>
                        <span>InterNations</span>
                        <span>2025 – present</span>
                        <span>Private source</span>
                    </div>
                    <div class={css.prose}>
                        <p>
                            InterNations’ Symfony console contains a large, powerful set of development and test-data
                            commands. Inc makes that surface discoverable: it reads each command’s live definition and
                            turns its arguments and options into a searchable terminal form, with contextual help and a
                            preview of the exact command before anything runs.
                        </p>
                        <p>
                            I built the complete tool in TypeScript on Bun, using React, OpenTUI, and Zustand for a
                            responsive two-pane interface. It remembers recent commands, keeps searchable execution
                            logs, switches environments, passes commands straight through when a form is not needed,
                            installs shell completion, and ships as self-updating native binaries through GitHub
                            Releases.
                        </p>
                    </div>
                    <div class={css.tagRow}>
                        <span class={css.tag}>TypeScript</span>
                        <span class={css.tag}>Bun</span>
                        <span class={css.tag}>React</span>
                        <span class={css.tag}>OpenTUI</span>
                        <span class={css.tag}>Zustand</span>
                        <span class={css.tag}>Commander</span>
                        <span class={css.tag}>Vitest</span>
                    </div>
                </div>
            </div>

            <div class={css.entry}>
                <div class={css.entryMedia}>
                    <div class:list={[css.frame, css.portraitFrame]}>
                        <div class={css.frameBar}>
                            <span class={css.frameDots} aria-hidden="true"><span></span><span></span><span></span></span
                            >
                            <span class={css.frameTitle}>$ gin</span>
                        </div>
                        <Image
                            src={imgGinMain}
                            alt="Gin showing the next and upcoming deployments, commit and pull-request counts, past releases, and Git shortcuts"
                            widths={[420, 700, 1076]}
                            sizes="(max-width: 800px) min(100vw, 420px), 420px"
                        />
                    </div>
                </div>
                <div class={css.entryText}>
                    <h3>Gin</h3>
                    <div class:list={[css.entryMeta, css.mono]}>
                        <span>InterNations</span>
                        <span>2025 – present</span>
                        <span>Private source</span>
                    </div>
                    <div class={css.prose}>
                        <p>
                            InterNations ships from date-named release branches, which makes everyday questions
                            needlessly expensive: Which branch is next? Is it available locally and remotely? What
                            changed, which commits are mine, and which of my pull requests target it? Gin puts the
                            release calendar and those answers in one interactive terminal view.
                        </p>
                        <p>
                            I built Gin as a compiled TypeScript and Bun application with a React and Ink interface
                            backed by Zustand. It derives the correct release branches from the schedule, fetches and
                            compares them, queries pull requests through the GitHub CLI, and links directly to
                            comparisons. It also acts as a transparent Git wrapper: commands it does not own go to Git
                            unchanged, while shortcuts such as
                            <code>deploy</code> and <code>upcoming</code> expand safely inside branches, ranges, and refspecs.
                        </p>
                    </div>
                    <div class={css.tagRow}>
                        <span class={css.tag}>TypeScript</span>
                        <span class={css.tag}>Bun</span>
                        <span class={css.tag}>React</span>
                        <span class={css.tag}>Ink</span>
                        <span class={css.tag}>Zustand</span>
                        <span class={css.tag}>date-fns</span>
                        <span class={css.tag}>Vitest</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="command-line-tools" class={css.section}>
        <div class={css.sectionHead}>
            <h2>
                <span class={css.sectionNumber} aria-hidden="true">{section('command-line-tools').number}</span>
                {section('command-line-tools').label}
            </h2>
            <p class={css.sectionNote}>
                Developer experience is a feature. Small tools that remove daily friction from the terminal—each one
                built because I kept wanting it.
            </p>
        </div>

        <div class={css.entries}>
            <div class={css.entry}>
                <div class={css.entryMedia}>
                    <div class={css.frame}>
                        <div class={css.frameBar}>
                            <span class={css.frameDots} aria-hidden="true"><span></span><span></span><span></span></span
                            >
                            <span class={css.frameTitle}>$ git prune-branches</span>
                        </div>
                        <video
                            data-demo
                            controls
                            muted
                            loop
                            playsinline
                            preload="metadata"
                            width="1200"
                            height="976"
                            poster="/portfolio/media/git-prune-branches-poster.webp"
                            aria-label="Screen recording of git-prune-branches selecting stale branches and previewing the git commands"
                        >
                            <source src="/portfolio/media/git-prune-branches.mp4" type="video/mp4" />
                        </video>
                    </div>
                </div>
                <div class={css.entryText}>
                    <h3>git-prune-branches</h3>
                    <div class:list={[css.entryMeta, css.mono]}>
                        <span>2025</span>
                    </div>
                    <div class={css.prose}>
                        <p>
                            Answers the eternal question of which local branches are safe to delete. It fetches and
                            prunes, then sorts branches into three groups—merged and safe (pre-selected), unmerged and
                            requiring a force-delete (deliberately not), and informational—and shows the exact
                            <Space />
                            <code>git</code> commands before running them.
                        </p>
                    </div>
                    <div class={css.linkRow}>
                        <a href="https://github.com/patik/git-prune-branches"
                            >GitHub <span aria-hidden="true">↗</span></a
                        >
                        <a href="https://www.npmjs.com/package/git-prune-branches"
                            >npm <span aria-hidden="true">↗</span></a
                        >
                    </div>
                </div>
            </div>

            <div class={css.entry}>
                <div class={css.entryMedia}>
                    <div class={css.frame}>
                        <div class={css.frameBar}>
                            <span class={css.frameDots} aria-hidden="true"><span></span><span></span><span></span></span
                            >
                            <span class={css.frameTitle}>inquirer-form-prompt</span>
                        </div>
                        <video
                            data-demo
                            controls
                            muted
                            loop
                            playsinline
                            preload="metadata"
                            width="1200"
                            height="1008"
                            poster="/portfolio/media/inquirer-form-prompt-poster.webp"
                            aria-label="Screen recording of inquirer-form-prompt filling text, radio, and checkbox fields in one terminal form"
                        >
                            <source src="/portfolio/media/inquirer-form-prompt.mp4" type="video/mp4" />
                        </video>
                    </div>
                </div>
                <div class={css.entryText}>
                    <h3>inquirer-form-prompt</h3>
                    <div class:list={[css.entryMeta, css.mono]}>
                        <span>2025</span>
                    </div>
                    <div class={css.prose}>
                        <p>
                            A form in the terminal: text inputs, radios, and checkboxes laid out on one screen with
                            sensible keyboard navigation—for CLIs that would otherwise ask a dozen questions one at a
                            time.
                        </p>
                    </div>
                    <div class={css.linkRow}>
                        <a href="https://github.com/patik/inquirer-form-prompt"
                            >GitHub <span aria-hidden="true">↗</span></a
                        >
                        <a href="https://www.npmjs.com/package/inquirer-form-prompt"
                            >npm <span aria-hidden="true">↗</span></a
                        >
                    </div>
                </div>
            </div>

            <div class={css.entry}>
                <div class={css.entryMedia}>
                    <div class={css.frame}>
                        <div class={css.frameBar}>
                            <span class={css.frameDots} aria-hidden="true"><span></span><span></span><span></span></span
                            >
                            <span class={css.frameTitle}>inquirer-grouped-checkbox</span>
                        </div>
                        <video
                            data-demo
                            controls
                            muted
                            loop
                            playsinline
                            preload="metadata"
                            width="1200"
                            height="864"
                            poster="/portfolio/media/inquirer-grouped-checkbox-poster.webp"
                            aria-label="Screen recording of inquirer-grouped-checkbox searching and selecting choices across groups"
                        >
                            <source src="/portfolio/media/inquirer-grouped-checkbox.mp4" type="video/mp4" />
                        </video>
                    </div>
                </div>
                <div class={css.entryText}>
                    <h3>inquirer-grouped-checkbox</h3>
                    <div class:list={[css.entryMeta, css.mono]}>
                        <span>2025</span>
                    </div>
                    <div class={css.prose}>
                        <p>
                            A checkbox prompt for long, structured lists: choices are grouped under selectable headers,
                            filterable in real time, with per-group counts and select-all / select-none controls.
                        </p>
                    </div>
                    <div class={css.linkRow}>
                        <a href="https://github.com/patik/inquirer-grouped-checkbox"
                            >GitHub <span aria-hidden="true">↗</span></a
                        >
                        <a href="https://www.npmjs.com/package/inquirer-grouped-checkbox"
                            >npm <span aria-hidden="true">↗</span></a
                        >
                    </div>
                </div>
            </div>

            <div class={css.entry}>
                <div class={css.entryMedia}>
                    <div class={css.frame}>
                        <div class={css.frameBar}>
                            <span class={css.frameDots} aria-hidden="true"><span></span><span></span><span></span></span
                            >
                            <span class={css.frameTitle}>inquirer-select-with-state</span>
                        </div>
                        <video
                            data-demo
                            controls
                            muted
                            loop
                            playsinline
                            preload="metadata"
                            width="812"
                            height="428"
                            poster="/portfolio/media/inquirer-select-with-state-poster.webp"
                            aria-label="Screen recording of inquirer-select-with-state updating a status banner above a select prompt"
                        >
                            <source src="/portfolio/media/inquirer-select-with-state.mp4" type="video/mp4" />
                        </video>
                    </div>
                </div>
                <div class={css.entryText}>
                    <h3>inquirer-select-with-state</h3>
                    <div class:list={[css.entryMeta, css.mono]}>
                        <span>2025</span>
                    </div>
                    <div class={css.prose}>
                        <p>
                            Inquirer’s select prompt with one addition: a live banner above the choices. Kick off async
                            work—a directory size, an API call—and stream its progress while the user decides.
                        </p>
                    </div>
                    <div class={css.linkRow}>
                        <a href="https://github.com/patik/inquirer-select-with-state"
                            >GitHub <span aria-hidden="true">↗</span></a
                        >
                        <a href="https://www.npmjs.com/package/inquirer-select-with-state"
                            >npm <span aria-hidden="true">↗</span></a
                        >
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="apps-and-sites" class={css.section}>
        <div class={css.sectionHead}>
            <h2>
                <span class={css.sectionNumber} aria-hidden="true">{section('apps-and-sites').number}</span>
                {section('apps-and-sites').label}
            </h2>
        </div>

        <div class={css.entries}>
            <div class={css.entry}>
                <div class={css.entryMedia}>
                    <a class={css.mediaLink} href="/dof/">
                        <span class={css.frame}>
                            <span class={css.frameBar}>
                                <span class={css.frameDots} aria-hidden="true"
                                    ><span></span><span></span><span></span></span
                                >
                                <span class={css.frameTitle}>patik.com/dof</span>
                            </span>
                            <Image
                                src={imgDofApp}
                                alt="The Depth of Field Calculator comparing two lenses, with a chart of the results"
                                widths={[700, 1200]}
                                sizes="(max-width: 800px) 100vw, 530px"
                            />
                        </span>
                    </a>
                </div>
                <div class={css.entryText}>
                    <h3>Depth-of-Field Calculator</h3>
                    <div class:list={[css.entryMeta, css.mono]}>
                        <span>2014 – present</span>
                    </div>
                    <div class={css.prose}>
                        <p>
                            A calculator and comparison tool for photographers. Line up any number of camera-and-lens
                            configurations, adjust apertures and distances, and compare the results in a chart. The
                            whole setup is encoded in the URL, so a comparison is easy to share.
                        </p>
                    </div>
                    <div class={css.linkRow}>
                        <a href="/dof/">Web app</a>
                        <a href="https://github.com/patik/dof">GitHub <span aria-hidden="true">↗</span></a>
                    </div>
                </div>
            </div>
        </div>

        <ul class:list={[css.listEntries, css.appendedList]}>
            <li class={css.listEntry}>
                <div class:list={[css.listIcon, css.sigil]} aria-hidden="true">&lbrace;&nbsp;&rbrace;</div>
                <div>
                    <h3>patik.com</h3>
                    <div class:list={[css.entryMeta, css.mono]}>
                        <span>This site</span>
                    </div>
                    <div class={css.prose}>
                        <p>
                            Astro with React islands, Cloudinary-backed travel galleries, and a CI pipeline that runs
                            visual-regression and accessibility tests with Playwright. The codebase is public.
                        </p>
                    </div>
                    <div class={css.linkRow}>
                        <a href="https://github.com/patik/patik.com">GitHub <span aria-hidden="true">↗</span></a>
                    </div>
                </div>
            </li>
        </ul>
    </section>

    <section id="libraries" class={css.section}>
        <div class={css.sectionHead}>
            <h2>
                <span class={css.sectionNumber} aria-hidden="true">{section('libraries').number}</span>
                {section('libraries').label}
            </h2>
            <p class={css.sectionNote}>
                Long-term maintenance is the point. These have been carried across several eras of the JavaScript
                ecosystem—script tags, jQuery, AMD, and now typed ES modules.
            </p>
        </div>

        <ul class={css.listEntries}>
            <li class={css.listEntry}>
                <div class={css.listIcon}>
                    <Image src={imgWithinViewportIcon} width={112} height={112} alt="" />
                </div>
                <div>
                    <h3>within-viewport</h3>
                    <div class:list={[css.entryMeta, css.mono]}>
                        <span>2011 – present</span>
                        <span>254 ★ on GitHub</span>
                    </div>
                    <div class={css.prose}>
                        <p>
                            Determines whether an element is entirely inside the viewport—or any scrollable container
                            —with configurable thresholds per side. Began as a jQuery plugin, rewritten over the years
                            into a dependency-free TypeScript package, with the API kept steady the whole way.
                        </p>
                    </div>
                    <div class={css.linkRow}>
                        <a href="https://patik.github.io/within-viewport/">Demo <span aria-hidden="true">↗</span></a>
