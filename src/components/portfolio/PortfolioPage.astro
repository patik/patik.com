<script>
    const videos = document.querySelectorAll<HTMLVideoElement>('video[data-demo]')
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
    const inView = new WeakSet<Element>()

    function sync(video: HTMLVideoElement): void {
        if (!reducedMotion.matches && inView.has(video)) {
            video.play().catch(() => undefined)
        } else {
            video.pause()
        }
    }

    const observer = new IntersectionObserver(
        (entries) => {
            for (const entry of entries) {
                if (!(entry.target instanceof HTMLVideoElement)) {
                    continue
                }

                if (entry.isIntersecting) {
                    inView.add(entry.target)
                } else {
                    inView.delete(entry.target)
                }

                sync(entry.target)
            }
        },
        { rootMargin: '100px' },
    )

    videos.forEach((video) => observer.observe(video))
    reducedMotion.addEventListener('change', () => videos.forEach(sync))

    // Never read, only held: WebKit collects a MediaQueryList that nothing references and takes its
    // listener with it, and the phones the mobile recording exists for are the ones running WebKit.
    const heldQueries: MediaQueryList[] = []

    // A <source media> is consulted once, while the browser picks a file, and never again — so a
    // visitor who crosses the breakpoint (rotating a tablet, dragging a window) keeps the file
    // chosen at load. `load()` re-runs that pick; the poster has to be moved by hand because it
    // lives on the <video>, not the <source>.
    videos.forEach((video) => {
        const variants = [...video.querySelectorAll<HTMLSourceElement>('source[media]')].map((source) => ({
            source,
            query: window.matchMedia(source.media),
        }))

        if (variants.length === 0) {
            return
        }

        heldQueries.push(...variants.map(({ query }) => query))

        function selectSource(): void {
            const match = variants.find(({ query }) => query.matches)?.source

            if (!match) {
                return
            }

            // Unconditional: the markup ships one poster, so the other breakpoint arrives here
            // already showing the right file behind the wrong still.
            if (match.dataset.poster) {
                video.poster = match.dataset.poster
            }

            // `source.src` reflects as an absolute URL, so this compares like with like.
            if (video.currentSrc === match.src) {
                return
            }

            const wasPlaying = !video.paused

            video.load()

            if (wasPlaying) {
                sync(video)
            }
        }

        selectSource()
        variants.forEach(({ query }) => query.addEventListener('change', selectSource))
    })
</script>
