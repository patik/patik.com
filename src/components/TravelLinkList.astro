---
import type { TravelLink } from '@src/travelLinks'
import { Image } from 'astro:assets'
import cardCss from './TravelLinkList.module.css'
import gridCss from './LinkGrid.module.css'

interface Props {
    items: TravelLink[]
}

// 2x the 336px tile cap in the travel card stylesheet. Clamped per image because some sources
// are only 336px wide and Astro would happily upscale them.
const maxRenderedWidth = 672

const { items } = Astro.props

function getItemClassNames(className: string): string[] {
    return className
        .split(' ')
        .filter(Boolean)
        .map((name) => cardCss[name] ?? name)
}
---

<div class:list={[gridCss.grid, gridCss.largeDesktopGap, gridCss.threeColumns, cardCss.travelLinkList]}>
    {
        items.map(({ imageSrc, imageAlt, url, className, title }) => (
            <a class={getItemClassNames(className).join(' ')} href={url}>
                <Image src={imageSrc} alt={imageAlt} width={Math.min(imageSrc.width, maxRenderedWidth)} />
                <span>{title}</span>
                <div class={cardCss.imageCover} />
            </a>
        ))
    }
</div>
