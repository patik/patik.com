---
import css from './HeaderNav.module.css'

interface NavItem {
    href: string
    label: string
    activePathPrefixes?: string[]
}

const navItems: NavItem[] = [
    { href: '/travel/', label: 'Travel' },
    { href: '/portfolio/', label: 'Portfolio', activePathPrefixes: ['/code/user-scripts/'] },
    { href: '/football/', label: 'Football' },
    { href: '/concerts/', label: 'Concerts' },
    { href: '/about/', label: 'About' },
]

const currentPath = Astro.url.pathname

function isActive({ href, activePathPrefixes = [] }: NavItem): boolean {
    return [href, ...activePathPrefixes].some((pathPrefix) => currentPath.startsWith(pathPrefix))
}
---

<nav class={css.nav}>
    <a class={css.brand} href="/">Craig Patik</a>
    <ul class={css.links}>
        {
            navItems.map((item) => (
                <li>
                    <a
                        href={item.href}
                        class:list={[css.link, { [css.active]: isActive(item) }]}
                        aria-current={isActive(item) ? 'page' : undefined}
                    >
                        {item.label}
                    </a>
                </li>
            ))
        }
    </ul>
</nav>
