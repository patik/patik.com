---
interface NavItem {
    href: string
    label: string
    className?: string
    activePathPrefixes?: string[]
}

const navItems: NavItem[] = [
    { href: '/', label: 'Home', className: 'hide-for-small' },
    { href: '/travel/', label: 'Travel' },
    { href: '/portfolio/', label: 'Portfolio', activePathPrefixes: ['/code/user-scripts/'] },
    { href: '/football/', label: 'Football' },
    { href: '/concerts/', label: 'Concerts' },
    { href: '/about/', label: 'About' },
]

const currentPath = Astro.url.pathname

function isActive({ href, activePathPrefixes = [] }: NavItem): boolean {
    if (href === '/') {
        return currentPath === '/'
    }

    return [href, ...activePathPrefixes].some((pathPrefix) => currentPath.startsWith(pathPrefix))
}
---

<nav class="main-nav">
    <h1>
        <a href="/">Craig Patik</a>
    </h1>
    <ul>
        {
            navItems.map((item) => (
                <li class={item.className}>
                    <a
                        href={item.href}
                        class:list={[{ active: isActive(item) }]}
                        aria-current={isActive(item) ? 'page' : undefined}
                    >
                        {item.label}
                    </a>
                </li>
            ))
        }
    </ul>
</nav>
