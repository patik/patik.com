---
import HeaderNav from './HeaderNav.astro'
import css from './Layout.module.css'
import '@src/styles/global.css'

const { title = '', keywords = [] } = Astro.props
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{`${title ? `${title} - ` : ''}Craig Patik`}</title>
        {keywords && keywords.length > 0 ? <meta name="keywords" content={keywords.join(',')} /> : null}
        {
            /* Keep here, not only in the body: Mastodon verifies against whichever page its
            profile field points at. */
        }
        <link rel="me" href="https://mastodon.online/@craigpatik" />
        <link rel="me" href="https://bsky.app/profile/craig.patik.com" />
        <link rel="stylesheet" href="https://use.typekit.net/tfz6xpv.css" />
        <meta name="author" content="Craig Patik" />
        <meta
            name="description"
            content="Craig Patik's homepage — travel logs & photos, and web design & development"
        />
        <slot name="head" />
    </head>
    <body>
        <div class={css.page}>
            <HeaderNav />
            <main class={css.main}>
                <slot />
            </main>
        </div>
    </body>
</html>
