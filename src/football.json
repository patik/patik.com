{
    "$schema": {
        "description": "Each entry is one football match attended. Sort by `date` for the chronological view (partial-ISO strings sort lexically). Mirrors the concerts.json event-centric model.",
        "fields": {
            "id": "unique slug",
            "date": "partial ISO 8601: YYYY, YYYY-MM, or YYYY-MM-DD",
            "datePrecision": "day | month | year (drives how you render the date)",
            "venue": "venue name",
            "city": "city",
            "state": "US state abbreviation, else null",
            "country": "country",
            "competition": "league, tournament, or match type",
            "season": "season string for club competitions, else null",
            "stage": "round, matchday, or leg, else null",
            "teams": "[{ name, role, score }] where role is home | away | neutral",
            "aggregate": "optional, for two-legged ties",
            "scorers": "[{ name, team, minute }] in chronological order; minute is a string to allow stoppage time",
            "attendance": "official attendance, else null",
            "referee": "referee name, else null",
            "note": "optional free-text"
        }
    },
