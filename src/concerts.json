            "id": "unique slug",
            "date": "partial ISO 8601: YYYY, YYYY-MM, or YYYY-MM-DD",
            "dateEnd": "optional, for multi-day festivals / multi-night runs",
            "datePrecision": "day | month | year (drives how you render the date)",
            "venue": "venue name",
            "city": "city",
            "state": "US state abbreviation, else null",
            "country": "country",
            "festival": "festival name, else null",
            "acts": "[{ name, role }] where role is main | opener | festival",
            "note": "optional free-text flag"
        }
    },
