# build output
dist/

# dependencies
node_modules/
# pnpm keeps its store beside the project when it can't use the home directory, which is
# what happens inside the scripts/visual.sh container. That run mounts a Docker volume
# over this path so it never reaches the host, but ignore it in case the mount is missed.
.pnpm-store/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env*.local
.env.development
.env.production

# macOS-specific files
.DS_Store

.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

.eslintcache
# Local Netlify folder
.netlify

.astro/*
!.astro/types.d.ts
tmp
tsconfig.tsbuildinfo

# Playwright
playwright-report/
test-results/

# Shared Copilot instruction symlinks
.github/instructions/*.instructions.md
.github/chatmodes
.github/prompts
